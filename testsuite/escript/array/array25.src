// An uninitialised entry sorts before every value, and sorted_insert agrees with sort().
// The comparators must be a strict weak ordering, or std::sort reads outside the array.

var a := { 3 };
a[3] := 1;
a[5] := 2;
print( "sort with uninit entries" );
print( a.sort() );
print( a );

var b := { { 0, 3 }, { 0 }, { 0, 1 } };
b[2][3] := 9;
print( "sort subindex with uninit entry" );
print( b.sort( 2 ) );
print( b );

var c := { 1, 3 };
c[4] := 5;
c.sort();
print( "sorted_insert next to uninit entries" );
c.sorted_insert( 2 );
print( c );
c.sorted_insert( 0 );
print( c );

var d := { 5, 1 };
d[4] := 3;
d.sort();
d.reverse();
print( "sorted_insert reverse with uninit entry" );
print( d );
d.sorted_insert( 4, 0, 1 );
print( d );
d.sorted_insert( 0, 0, 1 );
print( d );

var e := { { 0, 3 }, { 0, 1 } };
e[3] := { 0 };
e[3][3] := 9;
print( "sorted_insert subindex with uninit entry" );
e.sort( 2 );
e.sorted_insert( { 0, 2 }, 2 );
print( e );
e.sort( 2 );
e.reverse();
e.sorted_insert( { 0, 4 }, 2, 1 );
print( e );
e.sorted_insert( { 0, 0 }, 2, 1 );
print( e );
