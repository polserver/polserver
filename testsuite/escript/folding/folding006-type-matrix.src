// Every operator against every operand type, folded and unfolded. Each case runs the same
// expression twice -- once with literal operands, which the optimizer folds by applying the VM's
// own operator implementations, and once through variables, which the VM applies them itself --
// and reports only when the two disagree. A passing run prints just the tally.
//
// This is the sweep specs/escript/03 calls for, cut down to one representative value per type;
// the operand edge cases live in folding001-003.

var l;
var r;
var checks := 0;
var mismatches := 0;

function Chk( label, folded, runtime )
  checks := checks + 1;
  if ( TypeOf( folded ) != TypeOf( runtime ) )
    mismatches := mismatches + 1;
    print( "TYPE  " + label + " folded=" + TypeOf( folded ) + " runtime=" + TypeOf( runtime ) );
    return;
  endif
  if ( CStr( folded ) != CStr( runtime ) )
    mismatches := mismatches + 1;
    print( "VALUE " + label + " folded=" + CStr( folded ) + " runtime=" + CStr( runtime ) );
  endif
endfunction

