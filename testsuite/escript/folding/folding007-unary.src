// The unary operators, folded and unfolded. Both forms are printed side by side because a
// divergence such as `!` on a Real literal folding to a Real zero, where the VM gives an
// Integer, survives any test that looks at only one of them.

var i := 2;
var d := 2.1;
var z := 0.0;
var s := "abc";
var t := true;
var f := false;
var min := -2147483647-1;

print( "!int      " + CStr( !2 ) + " " + CStr( !i ) );
print( "!real     " + CStr( !2.1 ) + " " + CStr( !d ) );
print( "!zeroreal " + CStr( !0.0 ) + " " + CStr( !z ) );
print( "!string   " + CStr( !"abc" ) + " " + CStr( !s ) );
print( "!true     " + CStr( !true ) + " " + CStr( !t ) );
print( "!false    " + CStr( !false ) + " " + CStr( !f ) );

print( "-int      " + CStr( -( 2 ) ) + " " + CStr( -i ) );
print( "-real     " + CStr( -( 2.1 ) ) + " " + CStr( -d ) );
print( "-INT_MIN  " + CStr( -( -2147483647-1 ) ) + " " + CStr( -min ) );

print( "~int      " + CStr( ~( 2 ) ) + " " + CStr( ~i ) );
print( "~INT_MIN  " + CStr( ~( -2147483647-1 ) ) + " " + CStr( ~min ) );

print( "++int     " + CStr( ++( 2 ) ) + " " + CStr( ++i ) );
print( "--real    " + CStr( --( 2.1 ) ) + " " + CStr( --d ) );

// TypeOf must match too: a fold that returns the right number of the wrong type still changes
// what a script sees.
print( "types     " + TypeOf( !2.1 ) + " " + TypeOf( !d ) + " " + TypeOf( -( 2 ) ) +
       " " + TypeOf( -2 ) );
