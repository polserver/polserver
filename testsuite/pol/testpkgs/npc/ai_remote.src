use uo;
use os;
use npc;

// A remote control for the npc module.
//
// The functions in npc.em only run inside an NPC's own AI script, so a test
// cannot call them directly. It sends a command here instead and reads the
// answer back off its own event queue. Same convention as testattack's
// ai_attack.src: the test parks its pid in the "#TestPid" cprop.
//
// Commands are struct{ cmd, args }, answers are struct{ type := "result", ... }
// carrying the return value both as a number and as text, the error text if
// there was one, and where the NPC ended up - so that a test can check the
// outcome and the position it left behind in one go.
//
// A bounding box cannot travel through an event, so "makeboundingbox" parks it
// here and the commands that need one pick it up from there.
//
// System events are not commands, and one of them is worth passing on: an NPC
// that hears another NPC speak is the only observer of Say()'s and SayUC()'s
// do_event arm, so a speech event is forwarded to the test as
// struct{ type := "heard", ... }.

const SYSEVENT_SPEECH := 0x00000001;

program ai_remote()
  var me := Self();
  var bbox;

  while ( me )
    var ev := wait_for_event( 5 );
    if ( !ev )
      continue;
    endif

    if ( !ev.cmd )
      if ( ev.type == SYSEVENT_SPEECH )
        // langcode is only present when the speech carried one, which is what
        // tells a Say() apart from a SayUC() on this side
        var langcode := "";
        if ( ev.?langcode )
          langcode := ev.langcode;
        endif
        report( me, struct{ type := "heard",
                            source := ev.source.serial,
                            text := ev.text,
                            texttype := ev.texttype,
                            langcode := langcode } );
      endif
      continue;
    endif

    var res := dispatch( ev, bbox );

    // asking for the member rather than comparing against error: a module
    // function with nothing to return hands back an uninitialized object, and
    // that compares equal to error while supporting no members at all
    var errortext := "";
    if ( res.?errortext )
      errortext := res.errortext;
    endif

    // position() answers a struct, and a struct is the one kind of answer that
    // survives the trip home intact. Everything else keeps to the number and
    // text pair, so that a bounding box or an error still travels.
    var value := 0;
    if ( TypeOf( res ) == "Struct" )
      value := res;
    endif

    report( me, struct{ type := "result",
                        cmd := ev.cmd,
                        result := CInt( res ),
                        text := CStr( res ),
                        value := value,
                        errortext := errortext,
                        x := me.x,
                        y := me.y,
                        z := me.z,
                        facing := me.facing } );
  endwhile
endprogram

function report( me, answer )
  var parent := GetProcess( CInt( GetObjProperty( me, "#TestPid" ) ) );
  if ( parent )
    parent.SendEvent( answer );
  endif
endfunction

function dispatch( ev, byref bbox )
  var args := ev.args;

  case ( ev.cmd )
    "move":                 return Move( args[1] );
    "canmove":              return CanMove( args[1] );
    "wander":               return Wander();
    "walktowardlocation":   return WalkTowardLocation( args[1], args[2] );

    // the box is kept here between commands, and its type is reported back so
    // that the caller can tell a real box from the empty string
    "makeboundingbox":
      bbox := MakeBoundingBox( args[1] );
      return TypeOf( bbox );
    "islegalmove":          return IsLegalMove( args[1], bbox );
    "islegalmove_param":    return IsLegalMove( args[1], args[2] );
    "move_bbox":            return Move( bbox );
    "setanchor":            return SetAnchor( args[1], args[2], args[3], args[4] );
    "face":                 return Face( args[1], args[2] );
    "turntoward":           return TurnToward( args[1], args[2] );
    "turnawayfrom":         return TurnAwayFrom( args[1], args[2] );
    "turntowardlocation":   return TurnTowardLocation( args[1], args[2], args[3] );
    "turnawayfromlocation": return TurnAwayFromLocation( args[1], args[2], args[3] );
    "walktoward":           return WalkToward( args[1] );
    "walkawayfrom":         return WalkAwayFrom( args[1] );
    "runtoward":            return RunToward( args[1] );
    "runawayfrom":          return RunAwayFrom( args[1] );
    "runtowardlocation":    return RunTowardLocation( args[1], args[2] );
    "walkawayfromlocation": return WalkAwayFromLocation( args[1], args[2] );
    "runawayfromlocation":  return RunAwayFromLocation( args[1], args[2] );

    // speech: what these put on the wire is checked from the client package
    "say":
      return Say( args[1], args[2], args[3] );
    "sayuc":                return SayUC( args[1], args[2], args[3], args[4] );
    "position":             return position();
    "setwarmode":           return SetWarMode( args[1] );

    // an opponent can only be set from inside an AI script, which is what makes
    // the de-escalation of the reputation system reachable at all
    "setopponent":
      return SetOpponent( args[1] );

    // these two are uo.em, but they act on the executor this script runs on,
    // which is what the npc's eventmask member reports
    "enableevents":
      return EnableEvents( args[1], args[2], args[3] );
    "disableevents":        return DisableEvents( args[1] );
    "getproperty":          return GetProperty( args[1] );
    "setproperty":          return SetProperty( args[1], args[2] );
    default:                return error{ errortext := $"unknown command '{ev.cmd}'" };
  endcase
endfunction
