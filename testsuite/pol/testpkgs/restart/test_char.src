use os;
use uo;
use attributes;
use vitals;
include "testutil";

var testrun := CInt( GetEnvironmentVariable( "POLCORE_TEST_RUN" ) );

program test_char()
  return 1;
endprogram

// save/load test for things in Character class
exported function load_save_character()
  var props := {    //               {"Account", {"",1}}, // indirect
//               {"CharIdx", {"",1}}, // indirect
                 { "CmdLevel",
                   { "cmdlevel", 1 }
                 },
                 {
                   "Concealed",
                   { "concealed", 1 }
                 },
                 {
                   "TrueColor",
                   { "truecolor", 105 }
                 },
                 {
                   "TrueObjtype",
                   { "trueobjtype", 0x166 }
                 }, //       {"RegisteredHouse", {"",1}},
                 {
                   "Gender",
                   { "gender", 1 }
                 },
                 {
                   "Race",
                   { "race", RACE_GARGOYLE }
                 }, //                  {"Dead", {"",1}}, // other test
                 {
                   "MountedSteps",
                   { "mountedsteps", 7 }
                 },
                 {
                   "Hidden",
                   { "hidden", 1 }
                 },
                 {
                   "Frozen",
                   { "frozen", 1 }
                 },
                 {
                   "MovementWalkMod",
                   { "movecost_walk_mod", 8.1 }
                 },
                 {
                   "MovementRunMod",
                   { "movecost_run_mod", 8.2 }
                 },
                 {
                   "MovementWalkMountedMod",
                   { "movecost_walk_mounted_mod", 8.3 }
                 },
                 {
                   "MovementRunMountedMod",
                   { "movecost_run_mounted_mod", 8.4 }
                 },
                 {
                   "CarryingCapacityMod",
                   { "carrying_capacity_mod", 9 }
                 }, //           {"pAttr->name", {"",1}}, // functions
//          {"pVital->name", {"",1}}, // npc?
                 {
                   "Statcap",
                   { "statcap", 256 }
                 },
                 {
                   "Skillcap",
                   { "skillcap", 701 }
                 },
                 {
                   "Followers",
                   { "followers", 9 }
                 },
                 {
                   "FollowersMax",
                   { "followers_max", 10 }
                 },
                 {
                   "Tithing",
                   { "tithing", 11 }
                 }, //              {"MoveMode", {"",1}}, // npc test
//                 {"Privs", {"",1}}, //method
//              {"Settings", {"",1}}, //method
//             {"CreatedAt", {"",1}},
//        {"SquelchedUntil", {"",1}}, //method
//         {"DeafenedUntil", {"",1}}, //method
                 {
                   "TitlePrefix",
                   { "title_prefix", "myprefix" }
                 },
                 {
                   "TitleSuffix",
                   { "title_suffix", "mysuffix" }
                 },
                 {
                   "TitleGuild",
                   { "title_guild", "myguild" }
                 },
                 {
                   "TitleRace",
                   { "title_race", "myrace" }
                 },
                 {
                   "Murderer",
                   { "murderer", 1 }
                 }  //          {"PartyCanLoot", {"",1}}, // client only settable?
                 //            {"Reportable", {"",1}}, // other test
                 //            {"LastCorpse", {"",1}}, // other test
                 };

  if ( testrun == 1 )
    var chr := createAccountWithChar( "restart_test_char", "pass" );
    if ( !chr )
      return chr;
    endif
    foreach prop in props
      chr.set_member( prop[2][1], prop[2][2] );
    endforeach
    grantprivilege( chr, "hiddenattack" );
    grantprivilege( chr, "runwhilestealth" );
    chr.enable( "hiddenattack" );
    SetAttributeBaseValue( chr, "Strength", 900 );
    SetAttributeCap( chr, "Strength", 950 );
    SetAttributeLock( chr, "Strength", ATTRIBUTE_LOCK_DOWN );
    SetAttributeBaseValue( chr, "INT", 901 );
    SetAttributeCap( chr, "INT", 1002 );
    SetAttributeLock( chr, "INT", ATTRIBUTE_LOCK_LOCKED );

    chr.deaf( 300 );
    chr.squelch( 400 );
  else

    var a := FindAccount( "restart_test_char" );
    if ( !a )
      return ret_error( "failed to find account" );
    endif
    var chr := a.getcharacter( 1 );
    if ( !chr )
      return ret_error( "failed to find char" );
    endif
    foreach prop in props
      var val := chr.get_member( prop[2][1] );
      if ( val != prop[2][2] )
        return ret_error( $"Member {prop[2][1]} {prop[2][2]} != {val}" );
      endif
    endforeach
    if ( !chr.enabled( "hiddenattack" ) )
      return ret_error( "priv not enabled" );
    endif
    if ( chr.enabled( "runwhilestealth" ) )
      return ret_error( "priv is enabled" );
    endif
    if ( chr.privileges().size() != 2 )
      return ret_error( $"wrong number of privs {chr.privileges()}" );
    endif
    var v := { GetAttributeBaseValue( chr, "Strength" ), GetAttributeCap(
               chr, "Strength" ), GetAttributeLock( chr, "Strength" ) };
    if ( v != { 900, 950, ATTRIBUTE_LOCK_DOWN } )
      return ret_error( $"invalid STR values {v}" );
    endif
    v := { GetAttributeBaseValue( chr, "INT" ), GetAttributeCap(
           chr, "INT" ), GetAttributeLock( chr, "INT" ) };
    if ( v != { 901, 1002, ATTRIBUTE_LOCK_LOCKED } )
      return ret_error( $"invalid INT values {v}" );
    endif
    if ( !chr.deafed )
      return ret_error( "failed to save deaf status" );
    endif
    if ( !chr.squelched )
      return ret_error( "failed to save squelch status" );
    endif
  endif
  return 1;
endfunction

exported function load_save_character_dead()
  if ( testrun == 1 )
    var chr := createAccountWithChar( "restart_test_chardead", "pass" );
    if ( !chr )
      return chr;
    endif
    var chr1 := createAccountWithChar( "restart_test_charkiller", "pass" );
    if ( !chr1 )
      return chr1;
    endif
    chr.kill( chr1 );
    chr.setprop( "testcorpse", chr.getcorpse().serial );
  else

    var chr := FindAccount( "restart_test_chardead" ).getcharacter( 1 );
    if ( !chr )
      return ret_error( "failed to find char" );
    endif
    var chr1 := FindAccount( "restart_test_charkiller" ).getcharacter( 1 );
    if ( !chr )
      return ret_error( "failed to find char" );
    endif

    if ( !chr.dead )
      return ret_error( "chr is not dead" );
    endif
    if ( chr.getcorpse().serial != chr.getprop( "testcorpse" ) )
      return ret_error( "failed to save corpse" );
    endif
    if ( len( chr.reportables ) != 1 || chr.reportables[1].killer != chr1 )
      return ret_error( $"Invalid reportables: {chr.reportables}" );
    endif
  endif
  return 1;
endfunction

// A reportable is the only reputation entry that survives a restart, and it is
// keyed on the pair (serial, polclock) - so it can only be removed again if both
// halves came back verbatim. The clock is stored raw and read back raw: it is a
// polclock from the run that wrote it, and polclock starts again from zero, so
// what is loaded is a number from a clock that no longer exists. RemoveReportable
// is the one thing it still has to be good for.
exported function load_save_reportable_clock()
  if ( testrun == 1 )
    var chr := createAccountWithChar( "restart_test_repclock", "pass" );
    if ( !chr )
      return chr;
    endif
    var killer := createAccountWithChar( "restart_test_repkiller", "pass" );
    if ( !killer )
      return killer;
    endif

    chr.kill( killer );
    var entries := chr.reportables;
    if ( len( entries ) != 1 )
      return ret_error( $"the kill made {len( entries )} reportables" );
    endif
    chr.setprop( "repserial", entries[1].serial );
    chr.setprop( "repclock", entries[1].gameclock );
  else
    var chr := FindAccount( "restart_test_repclock" ).getcharacter( 1 );
    if ( !chr )
      return ret_error( "failed to find char" );
    endif

    var entries := chr.reportables;
    if ( len( entries ) != 1 )
      return ret_error( $"expected 1 reportable after the restart, got {entries}" );
    endif
    var serial := chr.getprop( "repserial" );
    var gameclock := chr.getprop( "repclock" );
    if ( entries[1].serial != serial )
      return ret_error( $"the reportable serial came back as 0x{entries[1].serial:x}" );
    endif
    if ( entries[1].gameclock != gameclock )
      return ret_error( $"the reportable clock came back as {entries[1].gameclock}, wrote {gameclock}" );
    endif

    var res := chr.removereportable( serial, gameclock );
    if ( res != 1 )
      return ret_error( $"removereportable answered {res}" );
    endif
    if ( len( chr.reportables ) )
      return ret_error( "the loaded reportable could not be removed" );
    endif
  endif
  return 1;
endfunction

// Everything else the reputation system holds is deliberately not saved. Only
// the murderer flag and the reportables have a line in printProperties; the
// criminal deadline and the aggressor and lawfully-damaged lists are dropped with
// the run that made them.
//
// The criminal flag is set with a level large enough that it could not have
// lapsed on its own, so a criminal on run 2 would mean it had been saved. The two
// lists have no such lever - AggressorFlagTimeout bounds them and they expire
// during run 1 either way - but a saved entry would still show: its deadline is a
// polclock from the old run, and polclock starts again from zero, so it would
// come back sitting far in the future and never lapse at all.
exported function load_save_repsys_flags()
  if ( testrun == 1 )
    var chr := createAccountWithChar( "restart_test_repflags", "pass" );
    if ( !chr )
      return chr;
    endif
    var other := createAccountWithChar( "restart_test_repother", "pass" );
    if ( !other )
      return other;
    endif

    chr.setmurderer( 1 );
    chr.setcriminal( 1000 );
    chr.setaggressorto( other );
    chr.setlawfullydamagedto( other );

    if ( !chr.temporally_criminal )
      return ret_error( "the criminal timer did not start" );
    endif
    if ( !len( chr.aggressorto ) || !len( chr.lawfullydamaged ) )
      return ret_error( "the aggressor lists were not filled" );
    endif
  else
    var chr := FindAccount( "restart_test_repflags" ).getcharacter( 1 );
    if ( !chr )
      return ret_error( "failed to find char" );
    endif

    if ( !chr.murderer )
      return ret_error( "the murderer flag was not saved" );
    endif
    if ( chr.temporally_criminal )
      return ret_error( "the criminal timer survived the restart" );
    endif
    if ( len( chr.aggressorto ) )
      return ret_error( $"the aggressor list survived the restart: {chr.aggressorto}" );
    endif
    if ( len( chr.lawfullydamaged ) )
      return ret_error( $"the lawfullydamaged list survived: {chr.lawfullydamaged}" );
    endif

    chr.setmurderer( 0 );
  endif
  return 1;
endfunction
