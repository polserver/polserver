  var item_to_add := resources.CreateItemAtLocation( char.x, char.y, char.z, 0xeed, 1, char.realm );

  if ( !lift_item_succeeded( res, item_to_add.serial ) )
    return res;
  endif

  if ( !drop_item_succeeded( res, item_to_add.serial, -1, -1, -1, subcont_backpack.serial ) )
    return res;
  endif

  return 1;
endfunction

// An item on a cursor must still be persisted, at its holder's feet - that is what
// WriteGottenItem does, and it is the only reason a lifted item survives a restart at all.
//
// This has to be asserted here rather than by shard_test_roundtrip. The cursor state does
// not survive a reload, and that test starts from what pass 2 saved, while pass 2 runs
// without a client and so can never put an item on a cursor. So force a save while the item
// is still held, and read it back out of the file this pass just wrote.
exported function gotten_item_is_saved()
  var item := CreateItemAtLocation( char.x, char.y, char.z, 0x1F03 );
  if ( !item )
    return ret_error( $"Could not create item: {item}" );
  endif

  item.movable := 1;

  var err;
  if ( !lift_item_succeeded( err, item.serial ) )
    DestroyItem( item );
    return err;
  endif

  var saved := SaveWorldState();
  if ( saved.errortext )
    DestroyItem( item );
    return ret_error( $"Could not save the world: {saved}" );
  endif

  var res := gotten_item_saved_at( item.serial, char.x, char.y, char.z );

  // the save must not have taken the item off the cursor
  if ( res == 1 and char.getgottenitem().serial != item.serial )
    res := ret_error( "The world save cleared the gotten item" );
  endif

  // DestroyItem clears the holder's side for us when the item is still gotten
  DestroyItem( item );
  return res;
endfunction

// A corpse renders what its owner wore at death. UO has no "move within a container", so dragging
// one of those items to another spot in the loot window is a lift and a drop like any other -- and
// the corpse has to still be wearing it afterwards.
exported function corpse_rearrange_keeps_layer()
  var corpse := make_equipped_corpse();
  if ( !corpse )
    return corpse;
  endif

  var test_func := @() {
    var res;
    var before := corpse_layer_serials( corpse );
    if ( !before )
      return before ?: ret_error( "The corpse renders no equipment at all" );
    endif

    var worn := before[1];

    // open the corpse first, as a looting player would
    Clear_Event_Queue();
    clientcon.sendevent( struct{ todo := "double_click", arg := corpse.serial, id := 0 } );
    if ( !( res := waitForClient( 0, { EVT_DOUBLE_CLICK } ) ) )
      return res;
    endif

    if ( !lift_item_succeeded( res, worn ) )
      return res;
    endif

    // back into the same corpse, at a different spot in its gump
    if ( !drop_item_succeeded( res, worn, 50, 50, 0, corpse.serial ) )
      return res;
    endif

    var after := corpse_layer_serials( corpse );
    if ( !after )
      return after ?: ret_error( "The corpse renders nothing after the item was put back" );
    endif

    if ( !( worn in after ) )
      return ret_error( $"Item {worn:#x} stopped rendering on the corpse after being moved within it" );
    endif

    return ret_error_not_equal( Len( after ), Len( before ),
                                "The corpse's equipment changed size after an item was moved within it" );
  };

  var res := test_func();
  DestroyItem( corpse );
  return res;
endfunction

// The other half of the same rule: an item the dead character never wore does not dress its corpse
// just by being dropped in.
exported function corpse_drop_loose_stays_loose()
  var corpse := make_equipped_corpse();
  if ( !corpse )
    return corpse;
  endif

  // equippable, and on a layer StartingEquipment leaves free
  var robe := CreateItemAtLocation( char.x, char.y, char.z, 0x1F03 );
  if ( !robe )
    DestroyItem( corpse );
    return ret_error( $"Could not create robe: {robe}" );
  endif
  robe.movable := 1;

  var test_func := @() {
    var res;
    var before := corpse_layer_serials( corpse );
    if ( !before )
      return before ?: ret_error( "The corpse renders no equipment at all" );
    endif

    if ( !lift_item_succeeded( res, robe.serial ) )
      return res;
    endif

    if ( !drop_item_succeeded( res, robe.serial, 50, 50, 0, corpse.serial ) )
      return res;
    endif

    var after := corpse_layer_serials( corpse );
    if ( !after )
      return after ?: ret_error( "The corpse renders nothing after the robe was dropped in" );
    endif

    if ( robe.serial in after )
      return ret_error( $"Robe {robe.serial:#x} dressed a corpse it was never worn on" );
    endif

    return ret_error_not_equal( Len( after ), Len( before ),
                                "The corpse's equipment changed size after a loose item was dropped in" );
  };

  var res := test_func();
  // the robe is inside the corpse by now on the success path, so destroy it either way first
  DestroyItem( robe );
  DestroyItem( corpse );
  return res;
endfunction

/**
 * Helper functions
 */
// Kills a freshly equipped NPC at the character's feet and returns its corpse. The caller owns it.
function make_equipped_corpse()
  var res := MoveObjectToLocation( char, charX, charY, 0 );
  if ( !res )
    return res;
  endif

  // leftovers from an earlier case would make the corpse lookup below ambiguous
  foreach old in ( ListItemsNearLocationOfType( charX, charY, 0, 2, 0x2006 ) )
    DestroyItem( old );
  endforeach

  var npc := CreateNPCFromTemplate( ":testnpc:probe_npc", char.x, char.y, char.z );
  if ( !npc )
    return ret_error( $"Could not create npc: {npc}" );
  endif

  if ( !( res := EquipFromTemplate( npc, "StartingEquipment" ) ) )
    return ret_error( $"Could not equip template: {res}" );
  endif

  npc.kill();
  Sleep( 1 );

  var corpse := ListItemsNearLocationOfType( charX, charY, 0, 2, 0x2006 )[1];
  if ( !corpse )
    return ret_error( "Could not find the corpse" );
  endif

  return corpse;
endfunction

// What the client is told the corpse is wearing, as an array of serials.
function corpse_layer_serials( corpse )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "list_equipped_items", arg := corpse.serial, id := 0 } );
  var ev := waitForClient( 0, { EVT_LIST_EQUIPPED_ITEMS } );
  if ( !ev )
    return ev;
  endif

  var serials := array{};
  foreach equipment in ( ev.objs )
    serials.append( equipment.serial );
  endforeach
  return serials;
endfunction

// Checks equiptest & equip or unequiptest & unequip events have expected values
function validate_events( evs, on_chr, by_chr, item, is_unequip )
  if ( evs.size() != 2 )
    return ret_error( $"Incorrect events array size, expected 2 got {evs.size()}" );
  endif
  foreach ev in evs
    var type := _ev_iter == 1 ? ( is_unequip ? "unequiptest" : "equiptest" ) : ( is_unequip ? "unequip" :
                                                                                 "equip" );

    if ( ev.on_chr != on_chr || ev.by_chr != by_chr || ev.item != item || ev.type != type )
      return ret_error( $"Unexpected event #{_ev_iter}: ev.on_chr ({ev.on_chr.name}) != on_chr ({on_chr.name}) || ev.by_chr ({ev.by_chr.name}) != by_chr ({by_chr.name}) || ev.item ({ev.item.name}) != item ({item.name}) || ev.type ({ev.type}) != type ({type})" );
    endif
  endforeach
  return 1;
endfunction

// Returns `count` events as an array, accepting only events of a type that are
// listed in `allowed_events`, eg. equiptest & equip or unequiptest & unequip
// events.
function get_events( allowed_events, timeout := 0, count := 2 )
  var evs := {};

  while ( Len( evs ) < count )
    var res := wait_for_event( timeout );
    if ( !res )
      return ret_error( "No event received" );
    elseif ( res.type in allowed_events )
      evs.append( res );
    endif
  endwhile
  return evs;
endfunction

// Create an NPC, setting its master to `char`, and return a newly-created item
// within the NPC's backpack.
function create_item_in_npc_pack_helper( resources, objtype := 0xeed )
  var res := MoveObjectToLocation( char, charX, charY, 0 );
  if ( !res )
    return res;
  endif

  var npc := resources.CreateNPCFromTemplate( ":testnpc:probe_npc", char.x, char.y, char.z );
  if ( !npc )
    return npc;
  endif

  npc.setmaster( char );

  var backpack := resources.CreateItemAtLocation( npc.x, npc.y, npc.z, 0xE75 );
  if ( !backpack )
    return backpack;
  endif

  res := EquipItem( npc, backpack );
  if ( !res )
    return res;
  endif

  var item := CreateItemInContainer( backpack, objtype, 1 );

  return item;
endfunction

enum EquipNpcDragdropFailReason
  // When MasterCanClotheNPCs=1 but char is not NPC's master
  FAIL_REASON_NOT_MASTER,

  // When MasterCanClotheNPCs=0 but char is NPC's master
  FAIL_REASON_CONFIG_NOT_ALLOWED
endenum

function equip_npc_dragdrop_fail_helper( resources, fail_reason )
  var res := MoveObjectToLocation( char, charX, charY, 0 );
  if ( !res )
    return res;
  endif

  var npc := resources.CreateNPCFromTemplate( ":testnpc:probe_npc", char.x, char.y, char.z );
  if ( !npc )
    return npc;
  endif

  var backpack := resources.CreateItemAtLocation( npc.x, npc.y, npc.z, 0xE75 );
  if ( !backpack )
    return backpack;
  endif

  res := EquipItem( npc, backpack );
  if ( !res )
    return res;
  endif

  var shirt := resources.CreateItemAtLocation( npc.x, npc.y, npc.z, "shirt_events" );
  if ( !shirt )
    return shirt;
  endif

  SetObjProperty( shirt, "#TestPid", GetPid() );

  if ( !lift_item_succeeded( res, shirt.serial ) )
    return res;
  endif

  if ( fail_reason == FAIL_REASON_NOT_MASTER )
    // Set MasterCanClotheNPCs but do not set NPC's master
    res := resources.UpdateConfiguration( struct{ MasterCanClotheNPCs := 1 } );
    if ( !res )
      return res;
    endif
  elseif ( fail_reason == FAIL_REASON_CONFIG_NOT_ALLOWED )
    // The default configuration has MasterCanClotheNPCs=0, so only set NPC's master
    npc.setmaster( char );
  endif

  if ( !wear_item_failed( res, shirt.serial, LAYER_SHIRT, npc.serial ) )
    return res;
  endif

  return 1;
endfunction

function realm_switch_delete_realm_drop_test_helper( resources, should_drop_too_far_away )
  var res;
  var realm := char.realm;
  var shadow_realm := $"shadow-{realm}";

  res := resources.AddRealm( shadow_realm, realm );
  if ( !res )
    return ret_error( $"Error creating realm: {res}" );
  endif

  var test_func := @() {
    // Move character to shadow realm
    res := MoveObjectToLocation( char, charX, charY, 0, shadow_realm );
    if ( !res )
      return ret_error( $"Error moving character to shadow realm: {res}" );
    endif

    // Verify character realm is shadow realm
    if ( char.realm != shadow_realm )
      return ret_error( $"Incorrect char.realm: expected {shadow_realm} got {char.realm}" );
    endif

    // Create container in shadow realm
    var container := resources.CreateItemAtLocation( char.x, char.y, char.z, "backpack",
                                                     1, shadow_realm );
    if ( !container )
      return ret_error( $"Error creating container in shadow realm: {container}" );
    endif

    // Create content item inside container
    var content := CreateItemInContainer( container, 0xeed );
    if ( !content )
      return ret_error( $"Error creating content in container: {content}" );
    endif

    // Pick up container
    if ( !lift_item_succeeded( res, container.serial ) )
      return res;
    endif

    // Check gotten item
    if ( char.getgottenitem() != container )
      return ret_error( $"char.gottenitem is not the container: expected {container.serial} got {char.getgottenitem().serial
                        ?: char.getgottenitem()}" );
    endif

    // Check container realm
    if ( container.realm != shadow_realm )
      return ret_error( $"Incorrect container.realm: expected {shadow_realm} got {container.realm}" );
    endif

    // Check container contents realm
    if ( content.realm != shadow_realm )
      return ret_error( $"Incorrect content.realm: expected {shadow_realm} got {container.realm}" );
    endif

    // Move back to britannia
    res := MoveObjectToLocation( char, charX, charY, 0, realm );
    if ( !res )
      return ret_error( $"Error moving character to back to base realm: {res}" );
    endif

    // Delete shadow realm
    res := DeleteRealm( shadow_realm );
    if ( !res )
      return ret_error( $"Error deleting shadow realm: {res}" );
    endif

    // Drop item on ground at feet
    if ( should_drop_too_far_away )
      if ( !drop_item_failed( res, container.serial, char.x + 5, char.y + 5, char.z ) )
        return res;
      endif
    else
      if ( !drop_item_succeeded( res, container.serial, char.x, char.y, char.z ) )
        return res;
      endif
    endif

    // Check container realm
    if ( container.realm != realm )
      return ret_error( $"Incorrect container.realm: expected {realm} got {container.realm}" );
    endif

    // Check container contents realm
    if ( content.realm != realm )
      return ret_error( $"Incorrect content.realm: expected {realm} got {container.realm}" );
    endif

    return 1;
  };

  res := test_func();

  // Move character back to britannia if test fails so realm can be destroyed by
  // resource manager.
  if ( !res )
    MoveObjectToLocation( char, charX, charY, 0, realm );
  endif

  return res;
endfunction

function drop_item_failed( byref err, serial, x, y, z, dropped_on_serial := 0xFFFFFFFF )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "drop_item",
                               arg := struct{ serial := serial, x := x, y := y,
                                              z := z, dropped_on_serial := dropped_on_serial },
                               id := 0 } );
  var ev;
  while ( 1 )
    ev := waitForClient( 0, { EVT_DROP_ITEM } );
    if ( !ev )
      return err := ev;
    endif
    break;
  endwhile

  while ( 1 )
    ev := waitForClient( 0, { EVT_MOVE_ITEM_REJECTED } );
    if ( !ev )
      return err := ev;
    endif
    break;
  endwhile
  return 1;
endfunction

function drop_item_succeeded( byref err, serial, x, y, z, dropped_on_serial := 0xFFFFFFFF )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "drop_item",
                               arg := struct{ serial := serial, x := x, y := y,
                                              z := z, dropped_on_serial := dropped_on_serial },
                               id := 0 } );
  var ev;
  while ( 1 )
    ev := waitForClient( 0, { EVT_DROP_ITEM } );
    if ( !ev )
      return err := ev;
    endif
    break;
  endwhile

  while ( 1 )
    ev := waitForClient( 0, { EVT_DROP_APPROVED } );
    if ( !ev )
      return err := ev;
    endif
    break;
  endwhile
  return 1;
endfunction

function wear_item_succeeded( byref err, item_serial, layer, player_serial, equipscript_testfunc )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "wear_item",
                               arg := struct{ item_serial := item_serial,
                                              layer := layer, player_serial := player_serial },
                               id := 0 } );

  if ( !( err := equipscript_testfunc() ) )
    return err;
  endif

  clientcon.sendevent( struct{ todo := "list_equipped_items", arg := player_serial, id := 0 } );
  var ev := waitForClient( 0, { EVT_LIST_EQUIPPED_ITEMS } );
  if ( !ev )
    return ev;
  endif

  if ( !ev.objs.find( @( equipped_item ) {
    return equipped_item.serial == item_serial;
  } ) )
    return ret_error( $"Item 0x{item_serial:x} not listed in equipment for player serial 0x{player_serial:x}" );
  endif

  return 1;
endfunction

function wear_item_failed( byref err, item_serial, layer, player_serial )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "wear_item",
                               arg := struct{ item_serial := item_serial,
                                              layer := layer, player_serial := player_serial },
                               id := 0 } );

  var ev;
  while ( 1 )
    ev := waitForClient( 0, { EVT_WEAR_ITEM } );
    if ( !ev )
      return err := ev;
    endif
    break;
  endwhile

  while ( 1 )
    ev := waitForClient( 0, { EVT_MOVE_ITEM_REJECTED } );
    if ( !ev )
      return err := ev;
    endif
    break;
  endwhile
  return 1;
endfunction

// Finds the item's block in the world save and checks it was written at x,y,z.
//
// Presence alone is already a tight assertion: a lifted item has been extricated from its
// zone, so write_items' zone walk cannot emit it, and the only other writer is
// WriteGottenItem. Where the block sits in the file is irrelevant - it is written after the
// zone walk, and a reload would file it back into zone order.
function gotten_item_saved_at( serial, x, y, z )
  var lines := ReadFile( "::data/items.txt" );
  if ( lines == error )
    return ret_error( $"Could not read items.txt: {lines}" );
  endif

  var wanted := $"0x{serial:x}";
  var in_block := 0;
  var seen := 0;
  var got_x, got_y, got_z;

  foreach line in lines
    var parts := SplitWords( line );
    if ( !in_block )
      // match the Serial key, not a bare substring: a Container line would point here too
      if ( parts.size() == 2 and parts[1] == "Serial" and parts[2] == wanted )
        in_block := 1;
      endif
    elseif ( parts.size() and parts[1] == "}" )
      break;
    elseif ( parts.size() == 2 )
      if ( parts[1] == "X" )
        got_x := CInt( parts[2] );
        seen += 1;
      elseif ( parts[1] == "Y" )
        got_y := CInt( parts[2] );
        seen += 1;
      elseif ( parts[1] == "Z" )
        got_z := CInt( parts[2] );
        seen += 1;
      endif
    endif
  endforeach

  if ( !in_block )
    return ret_error( $"Gotten item {serial:#x} was not saved to items.txt" );
  endif
  if ( seen != 3 )
    return ret_error( $"Gotten item {serial:#x} was saved without a full position" );
  endif
  if ( got_x != x or got_y != y or got_z != z )
    return ret_error( $"Gotten item {serial:#x} saved at {got_x},{got_y},{got_z}, expected its holder's {x},{y},{z}" );
  endif

  return 1;
endfunction

function lift_item_succeeded( byref err, serial )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "lift_item", arg := serial, id := 0 } );
  var ev;
  while ( 1 )
    ev := waitForClient( 0, { EVT_LIFT_ITEM } );
    if ( !ev )
      return err := ev;
    endif
    break;
  endwhile

  // TODO: see top
  ev := waitForClient( 0, { EVT_MOVE_ITEM_REJECTED }, 1 );
  if ( ev )
    return err := ret_error( $"Got unexpected move (lift) item rejected: reason = {ev.reason}" );
  endif
  return 1;
endfunction
