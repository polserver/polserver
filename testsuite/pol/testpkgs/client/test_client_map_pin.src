exported function pin_remove_drops_pin( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif
  mp.appendpin( PIN1_X, PIN1_Y );
  mp.appendpin( PIN2_X, PIN2_Y );
  res := start_plotting( mp );
  if ( !res )
    return res;
  endif

  send_pin( MAP_REMOVE, mp, 0 );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var text := map_pin_text( mp );
  if ( text != $"{PIN2_X},{PIN2_Y};" )
    return ret_error( $"wrong pins: {text}" );
  endif

  return 1;
endfunction

exported function pin_remove_bad_index( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif
  mp.appendpin( PIN1_X, PIN1_Y );
  res := start_plotting( mp );
  if ( !res )
    return res;
  endif

  send_pin( MAP_REMOVE, mp, 1 );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var text := map_pin_text( mp );
  if ( text != $"{PIN1_X},{PIN1_Y};" )
    return ret_error( $"wrong pins: {text}" );
  endif

  return 1;
endfunction

// Remove-all carries no index and no coordinate, so the plotting gate is the
// only thing in front of it.
exported function pin_remove_all_clears( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif
  mp.appendpin( PIN1_X, PIN1_Y );
  mp.appendpin( PIN2_X, PIN2_Y );

  // still refused while the map is not plotting
  send_pin( MAP_REMOVE_ALL, mp );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif
  var text := map_pin_text( mp );
  if ( text != $"{PIN1_X},{PIN1_Y};{PIN2_X},{PIN2_Y};" )
    return ret_error( $"pins were cleared without plotting: {text}" );
  endif

  res := start_plotting( mp );
  if ( !res )
    return res;
  endif
  send_pin( MAP_REMOVE_ALL, mp );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif
  text := map_pin_text( mp );
  if ( text != "" )
    return ret_error( $"pins survived a remove all: {text}" );
  endif

  return 1;
endfunction

// A map whose itemdesc says it may not be edited answers nothing at all, not
// even a toggle - the check sits above the whole switch.
exported function pin_not_editable( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var locked := make_map( resmgn, TESTMAP_LOCKED );
  if ( !locked )
    return locked;
  endif
  locked.appendpin( PIN1_X, PIN1_Y );

  // an editable map to settle on, since the locked one will not answer
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif

  send_pin( MAP_TOGGLE_EDIT, locked );
  send_pin( MAP_ADD, locked, 0, 40, 30 );
  send_pin( MAP_REMOVE_ALL, locked );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var text := map_pin_text( locked );
  if ( text != $"{PIN1_X},{PIN1_Y};" )
    return ret_error( $"a locked map was edited: {text}" );
  endif

  return 1;
endfunction

// The serial names an item the character cannot reach, so there is nothing to
// plot on.
exported function pin_out_of_reach( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var far := resmgn.CreateItemAtLocation( MAP_X + 60, MAP_Y, 0, TESTMAP );
  if ( !far )
    return ret_error( $"could not create the far map: {far}" );
  endif
  far.gumpwidth := MAP_GUMPWIDTH;
  far.gumpheight := MAP_GUMPHEIGHT;
  far.xwest := MAP_WEST;
  far.ynorth := MAP_NORTH;
  far.xeast := MAP_EAST;
  far.ysouth := MAP_SOUTH;

  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif

  send_pin( MAP_TOGGLE_EDIT, far );
  send_pin( MAP_ADD, far, 0, 40, 30 );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var text := map_pin_text( far );
  if ( text != "" )
    return ret_error( $"a map out of reach was plotted on: {text}" );
  endif

  return 1;
endfunction

// The serial names an item the character can reach that is not a map. Every
// field the handler would read lives past the end of a plain item, so this used
// to be applied to whatever those bytes happened to be; the class is checked
// now. The settle afterwards is the real assertion - it says the shard is still
// answering.
exported function pin_serial_is_not_a_map( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var coin := resmgn.CreateItemInContainer( char.backpack, MAP_NOT_A_MAP );
  if ( !coin )
    return ret_error( $"could not create a coin: {coin}" );
  endif

  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif

  send_pin( MAP_TOGGLE_EDIT, coin );
  send_pin( MAP_ADD, coin, 0, 40, 30 );
  send_pin( MAP_INSERT, coin, 0, 40, 30 );
  send_pin( MAP_CHANGE, coin, 0, 40, 30 );
  send_pin( MAP_REMOVE, coin, 0 );
  send_pin( MAP_REMOVE_ALL, coin );

  res := pin_settle( mp );
  if ( !res )
    return res;
  endif
  if ( coin.objtype != MAP_NOT_A_MAP )
    return ret_error( $"the coin became a {coin.objtype}" );
  endif

  return 1;
endfunction

// A toggle flips the state and says which way it went, in the byte that carries
// the pin index everywhere else. The coordinates it carries are echoed back
// untouched.
exported function pin_toggle_reports_state( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif

  send_pin( MAP_TOGGLE_EDIT, mp, 0, 7, 9 );
  var ev := wait_for_pin( mp );
  if ( !ev )
    return ev;
  endif
  if ( CInt( ev.action ) != MAP_TOGGLE_RESPONSE )
    return ret_error( $"answered with action {ev.action}" );
  endif
  if ( CInt( ev.pinidx ) != 1 )
    return ret_error( $"plotting came back as {ev.pinidx}, wanted 1" );
  endif
  if ( CInt( ev.x ) != 7 || CInt( ev.y ) != 9 )
    return ret_error( $"the coordinates came back as {ev.x},{ev.y}" );
  endif

  send_pin( MAP_TOGGLE_EDIT, mp );
  ev := wait_for_pin( mp );
  if ( !ev )
    return ev;
  endif
  if ( CInt( ev.pinidx ) != 0 )
    return ret_error( $"plotting came back as {ev.pinidx}, wanted 0" );
  endif

  return 1;
endfunction
