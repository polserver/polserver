// handle_map_pin: the six commands a client may send about a map, the plotting
// gate in front of five of them, and the three things it checks before it will
// look at a map at all.
//
// Only a toggle is answered. Every other command is applied or dropped in
// silence, so each case sends what it wants to test, settles the connection
// with a toggle pair, and then reads the map's pin list from script - the pin
// list is the only readout there is.
//
// Coordinates on the wire are gump pixels. The map these cases build is 160
// tiles across an 80 pixel gump, so a pin comes back at twice its offset plus
// the west edge.

include "map";

program test_client_map_pin()
  return map_setup();
endprogram

// A pin lands where gumpToWorld puts it, which is not where the client named.
exported function pin_add_plots_pin( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif
  res := start_plotting( mp );
  if ( !res )
    return res;
  endif

  send_pin( MAP_ADD, mp, 0, 40, 30 );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var x := gump_to_world( 40 );
  var y := gump_to_world( 30, MAP_NORTH, MAP_SOUTH, MAP_GUMPHEIGHT );
  var text := map_pin_text( mp );
  if ( text != $"{x},{y};" )
    return ret_error( $"wrong pins: {text}" );
  endif

  return 1;
endfunction

// Plotting has to be turned on first: a client that never toggled is ignored.
exported function pin_add_needs_plotting( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif

  send_pin( MAP_ADD, mp, 0, 40, 30 );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var text := map_pin_text( mp );
  if ( text != "" )
    return ret_error( $"a pin was plotted without plotting: {text}" );
  endif

  return 1;
endfunction

// The last pixel of the gump is inside it and the first one past it is not, so
// nothing a client sends can be scaled into a coordinate outside the area the
// map stands for.
exported function pin_add_at_gump_edge( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif
  res := start_plotting( mp );
  if ( !res )
    return res;
  endif

  send_pin( MAP_ADD, mp, 0, MAP_GUMPWIDTH - 1, MAP_GUMPHEIGHT - 1 );
  send_pin( MAP_ADD, mp, 0, MAP_GUMPWIDTH, 0 );
  send_pin( MAP_ADD, mp, 0, 0, MAP_GUMPHEIGHT );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var x := gump_to_world( MAP_GUMPWIDTH - 1 );
  var y := gump_to_world( MAP_GUMPHEIGHT - 1, MAP_NORTH, MAP_SOUTH, MAP_GUMPHEIGHT );
  var text := map_pin_text( mp );
  if ( text != $"{x},{y};" )
    return ret_error( $"wrong pins: {text}" );
  endif
  if ( x > MAP_EAST || y > MAP_SOUTH )
    return ret_error( $"the last pixel of the gump landed at {x},{y}, outside the map" );
  endif

  return 1;
endfunction

// A pixel well past the gump is refused however small the map's own area is
// against it. This used to be accepted - the check compared the pixel against
// the area's width in *tiles* - and 150 here scaled to a world coordinate
// outside both the map and the realm.
exported function pin_add_out_of_gump( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif
  res := start_plotting( mp );
  if ( !res )
    return res;
  endif

  send_pin( MAP_ADD, mp, 0, 150, 10 );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var text := map_pin_text( mp );
  if ( text != "" )
    return ret_error( $"a pin outside the gump was plotted: {text}" );
  endif

  return 1;
endfunction

// The other way round: a map standing for less ground than its gump has pixels.
// The whole gump is still plottable - the check used to bound the pixel by the
// area's width in tiles, so on a map like this one everything but the first few
// pixels was silently dropped from an ordinary client.
exported function pin_add_small_area( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif
  // 20 tiles across the same 80 pixel gump, so four pixels to the tile
  mp.xeast := MAP_WEST + 20;
  mp.ysouth := MAP_NORTH + 20;
  res := start_plotting( mp );
  if ( !res )
    return res;
  endif

  send_pin( MAP_ADD, mp, 0, 60, 60 );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var x := gump_to_world( 60, MAP_WEST, MAP_WEST + 20 );
  var y := gump_to_world( 60, MAP_NORTH, MAP_NORTH + 20, MAP_GUMPHEIGHT );
  var text := map_pin_text( mp );
  if ( text != $"{x},{y};" )
    return ret_error( $"wrong pins: {text}" );
  endif

  return 1;
endfunction

exported function pin_insert_at_index( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif
  mp.appendpin( PIN1_X, PIN1_Y );
  mp.appendpin( PIN2_X, PIN2_Y );
  res := start_plotting( mp );
  if ( !res )
    return res;
  endif

  send_pin( MAP_INSERT, mp, 1, 40, 30 );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var x := gump_to_world( 40 );
  var y := gump_to_world( 30, MAP_NORTH, MAP_SOUTH, MAP_GUMPHEIGHT );
  var text := map_pin_text( mp );
  if ( text != $"{PIN1_X},{PIN1_Y};{x},{y};{PIN2_X},{PIN2_Y};" )
    return ret_error( $"wrong pins: {text}" );
  endif

  return 1;
endfunction

// Insert, change and remove all address a pin by index, and the highest one
// they take is the last pin - unlike the script method, which lets an insert
// name the position one past the end.
exported function pin_insert_bad_index( resmgn )
  var res := map_start();
  if ( !res )
    return res;
  endif
  var mp := make_map( resmgn );
  if ( !mp )
    return mp;
  endif
  mp.appendpin( PIN1_X, PIN1_Y );
  res := start_plotting( mp );
  if ( !res )
    return res;
  endif

  send_pin( MAP_INSERT, mp, 1, 40, 30 );
  res := pin_settle( mp );
  if ( !res )
    return res;
  endif

  var text := map_pin_text( mp );
  if ( text != $"{PIN1_X},{PIN1_Y};" )
    return ret_error( $"wrong pins: {text}" );
  endif

  return 1;
endfunction

