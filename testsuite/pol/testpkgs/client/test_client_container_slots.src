use os;
use uo;

include "communication";
include "testutil";

// Container slots, with UseContainerSlots on: each item in a container is filed under a slot of its
// own, which is what a client from 7.0.9.0 on lays the container out by. Scripts cannot read a
// slot, so it is read back from the client.

var char;
var clientcon := getClientConnection();

program test_container_slots()
  var a := FindAccount( "testclient0" );
  char := a.getcharacter( 1 );
  if ( !char )
    return ret_error( "Could not find char at slot 1" );
  endif
  return 1;
endprogram

exported function create_takes_free_slot( resmgr )
  // Creating an item in a container gives it a slot nothing else there has, so two created one
  // after the other never share one. Gold a vendor pays for a sale is created the same way.
  var res := resmgr.UpdateConfiguration( struct{ UseContainerSlots := 1 } );
  if ( !res )
    return res;
  endif
  var first := resmgr.CreateItemInContainer( char.backpack, "shirt_plain" );
  var second := resmgr.CreateItemInContainer( char.backpack, "shirt_plain" );
  if ( !first or !second )
    return ret_error( "failed to create the items" );
  endif

  var first_slot := client_slot( clientcon, first.serial, char.backpack.serial );
  if ( first_slot == error )
    return first_slot;
  endif
  var second_slot := client_slot( clientcon, second.serial, char.backpack.serial );
  if ( second_slot == error )
    return second_slot;
  endif
  if ( first_slot == second_slot )
    return ret_error( $"both items were filed under slot {first_slot}" );
  endif
  return 1;
endfunction
