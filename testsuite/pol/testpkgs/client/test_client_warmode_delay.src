// The war mode throttle. combat.cfg sets WarModeDelay to 0 for the client tests,
// so this case turns it back on to keep it covered.

use os;
use uo;

include "testutil";
include "communication";

const CFG_PATH := "::config/combat.cfg";

// The throttle arms off the whole-second game clock, so a delay of D leaves a
// window of D - frac(now). 3 leaves at least two seconds, well above a round trip.
const GUARD_DELAY := 3;

// The restore has to outlast the window this case armed, so the two move together.
const FORCE_TIMEOUT := ( GUARD_DELAY + 7 ) * 1000;

var char;
var clientcon := getClientConnection();

program test_client_warmode_delay()
  var a := FindAccount( "testclient0" );
  char := a.getcharacter( 1 );
  if ( !char )
    return ret_error( "Could not find char at slot 1" );
  endif
  return 1;
endprogram

// Puts client 0 in or out of war mode, retrying while the core throttles it.
function force_warmode( war )
  var deadline := ReadMillisecondClock() + FORCE_TIMEOUT;
  while ( char.warmode != war and ReadMillisecondClock() < deadline )
    Clear_Event_Queue();
    clientcon.sendevent( struct{ todo := "war_mode", arg := war, id := 0 } );
    waitForClient( 0, { EVT_WAR_MODE }, QUIET_SECS );
    if ( char.warmode == war )
      break;
    endif
    sleepms( POLL_INTERVAL * 1000 );
  endwhile
  if ( char.warmode != war )
    return ret_error( $"the core has war mode {char.warmode}, expected {war}" );
  endif
  return 1;
endfunction

// Split out so the caller can put the config back on every path out of it.
function check_throttle()
  // Clear what earlier cases left in flight, so a stale war mode event is not taken
  // for the first answer.
  var quiet := client_sync( clientcon, 0 );
  if ( !quiet )
    return quiet;
  endif

  // The first change after the throttle is armed goes through.
  clientcon.sendevent( struct{ todo := "war_mode", arg := 1, id := 0 } );
  var ev := waitForClient( 0, { EVT_WAR_MODE } );
  if ( !ev )
    return ret_error( "the core refused the first war mode change" );
  endif
  if ( CInt( ev.war ) != 1 )
    return ret_error( $"client answered war mode {ev.war}, expected 1" );
  endif
  if ( !char.warmode )
    return ret_error( "the client was told war mode was set but the core has it clear" );
  endif

  // The next one inside the window is dropped: the core answers with a movement
  // packet. The barrier proves no war mode packet was queued ahead of it.
  clientcon.sendevent( struct{ todo := "war_mode", arg := 0, id := 0 } );
  var res := no_event_before_sync( clientcon, 0, { EVT_WAR_MODE } );
  if ( !res )
    return res;
  endif
  if ( !char.warmode )
    return ret_error( "a war mode change inside the throttle window was applied anyway" );
  endif
  return 1;
endfunction

exported function warmode_delay_throttles( unused resmgn )
  // Out of war mode to start with, while changes are still free.
  var res := force_warmode( 0 );
  if ( !res )
    return res;
  endif

  var original := set_cfg_key( CFG_PATH, "WarModeDelay", GUARD_DELAY );
  if ( !original )
    return original;
  endif

  res := check_throttle();

  // Restore the config, and wait out the armed window: the character's deadline
  // outlives the config change.
  restore_cfg( CFG_PATH, original );
  var restored := force_warmode( 0 );
  if ( !res )
    return res;
  endif
  return restored;
endfunction
