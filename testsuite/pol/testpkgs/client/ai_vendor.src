use npc;
use os;
use uo;

// The merchant of the vendor tests. The core tells this NPC alone how a sale through its window
// went, so each report is passed on to the test that parked its pid in the "#TestPid" cprop:
// the gold paid when the core handles the sale, the shopping list when a script does.

const SYSEVENT_MERCHANT_BOUGHT := 0x0100;

program ai_vendor()
  while ( 1 )
    var ev := os::wait_for_event( 60 );
    if ( ev and ev.type == SYSEVENT_MERCHANT_BOUGHT )
      report( ev );
    endif
  endwhile
endprogram

function report( ev )
  var told := struct{ type := "merchant_bought", source := ev.source.serial };
  // Each handler sends only one of the two, and which one is part of what is being tested.
  if ( ev.exists( "amount" ) )
    told.+amount := ev.amount;
  endif
  if ( ev.exists( "shoppinglist" ) )
    var list := array{};
    foreach entry in ( ev.shoppinglist )
      list.append( struct{ serial := entry.item.serial, amount := entry.amount } );
    endforeach
    told.+shoppinglist := list;
  endif

  var parent := GetProcess( CInt( GetObjProperty( Self(), "#TestPid" ) ) );
  if ( parent )
    parent.SendEvent( told );
  endif
endfunction
