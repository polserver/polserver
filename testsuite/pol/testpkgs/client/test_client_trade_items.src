// Putting items into the trade window, and every way of getting them back out
// again without a completed trade.

include "trade";

program test_trade_items()
  return trade_setup();
endprogram

// An offered item leaves the backpack for the caller's own side of the window,
// and both clients are shown it there.
exported function offer_moves_item( resmgn )
  var res := open_trade();
  if ( !res )
    return res;
  endif

  var item := resmgn.CreateItemInContainer( char.backpack, 0x1F03 );
  if ( !item )
    return item;
  endif
  item.movable := 1;

  res := MoveItemToSecureTradeWin( item, char );
  if ( !res )
    return ret_error( $"Could not offer the item: {res}" );
  endif

  var cont := char.tradewindow.serial;
  if ( item.container.serial != cont )
    return ret_error( $"the item is in 0x{item.container.serial:x}, expected the trade window 0x{cont:x}" );
  endif

  // the offering client and the one being offered to both see it
  res := client_finds_obj( clientcon, 0, item.serial, cont );
  if ( !res )
    return res;
  endif
  res := client_finds_obj( clientcon, 1, item.serial, cont );
  if ( !res )
    return res;
  endif

  close_trades();
  return 1;
endfunction

// An item nobody may move is refused, and so is one another script has reserved.
exported function offer_refuses_unmovable( resmgn )
  var res := open_trade();
  if ( !res )
    return res;
  endif

  var item := resmgn.CreateItemInContainer( char.backpack, 0x1F03 );
  if ( !item )
    return item;
  endif
  item.movable := 0;

  res := MoveItemToSecureTradeWin( item, char );
  if ( res )
    return ret_error( "an immobile item was offered" );
  elseif ( res.errortext != "That is immobile" )
    return ret_error( $"unexpected error for an immobile item: {res.errortext}" );
  endif

  // a reservation belongs to the script that made it, so the item has to be
  // reserved by someone else for the core to call it "in use"
  item.movable := 1;
  var holder := resmgn.Start_Script( ":TestClient:reserve_holder.ecl", struct{ parent := GetProcess(),
                                                                               item := item } );
  if ( !holder )
    return holder;
  endif
  var ev := Wait_For_Event( 10 );
  if ( !ev )
    return ret_error( "the reserving script did not answer" );
  endif

  res := MoveItemToSecureTradeWin( item, char );
  if ( res )
    return ret_error( "an item reserved by another script was offered" );
  elseif ( res.errortext != "That item is being used." )
    return ret_error( $"unexpected error for a reserved item: {res.errortext}" );
  endif

  close_trades();
  return 1;
endfunction

// Offering needs a window to offer into, and something that is an item. Neither
// refusal may move the item: the window is looked for before the item is taken
// out of its container, and a refused offer that left it extricated would be in
// no container and not in the world.
exported function offer_refuses_without_window( resmgn )
  close_trades();

  var item := resmgn.CreateItemInContainer( char.backpack, 0x1F03 );
  if ( !item )
    return item;
  endif
  item.movable := 1;

  var res := MoveItemToSecureTradeWin( item, char );
  if ( res )
    return ret_error( "an item was offered without a trade window" );
  elseif ( res.errortext != "Unable to complete trade" )
    return ret_error( $"unexpected error without a window: {res.errortext}" );
  endif

  res := MoveItemToSecureTradeWin( "not an item", char );
  if ( res )
    return ret_error( "a string was offered as an item" );
  elseif ( res.errortext != "Invalid parameter type" )
    return ret_error( $"unexpected error for a string item: {res.errortext}" );
  endif

  // the item never left the backpack
  if ( item.container.serial != char.backpack.serial )
    return ret_error( $"the item is in 0x{item.container.serial:x}, expected the backpack" );
  endif
  return 1;
endfunction

// A mobile without a client has no window either, and is refused before the item
// is touched - the trade code would otherwise be handed a null client.
exported function offer_refuses_without_client( resmgn )
  close_trades();

  var npc := resmgn.CreateNPCFromTemplate( ":testnpc:probe_npc", char.x, char.y, char.z );
  if ( !npc )
    return npc;
  endif
  var item := resmgn.CreateItemInContainer( char.backpack, 0x1F03 );
  if ( !item )
    return item;
  endif
  item.movable := 1;

  var res := MoveItemToSecureTradeWin( item, npc );
  if ( res )
    return ret_error( "an item was offered to an npc" );
  elseif ( res.errortext != "No client attached." )
    return ret_error( $"unexpected error for an npc: {res.errortext}" );
  endif

  if ( item.container.serial != char.backpack.serial )
    return ret_error( $"the item is in 0x{item.container.serial:x}, expected the backpack" );
  endif
  return 1;
endfunction

// Cancelling a trade hands every offered item back to the side that offered it.
exported function cancel_returns_items( resmgn )
  var res := offer_from_both_sides( resmgn );
  if ( !res )
    return res;
  endif
  var [ item, item2 ] := res;

  close_trades();
  return items_are_back( item, item2 );
endfunction

// Walking more than 3 tiles away from the partner cancels the trade -
// AllowMovingTrade is off in the test shard - and that returns the items too.
exported function walking_away_cancels( resmgn )
  var res := offer_from_both_sides( resmgn );
  if ( !res )
    return res;
  endif
  var [ item, item2 ] := res;

  // the first step in a new direction only turns the character, so this takes
  // one more than the distance
  var steps := 8;
  while ( steps > 0 and char.tradewindow )
    res := move_client( 0, 6 );
    if ( !res )
      MoveObjectToLocation( char, 100, 50, 0, flags := MOVEOBJECT_FORCELOCATION );
      return res;
    endif
    steps := steps - 1;
  endwhile

  var gap := CoordinateDistance( char.x, char.y, char2.x, char2.y );
  MoveObjectToLocation( char, 100, 50, 0, flags := MOVEOBJECT_FORCELOCATION );

  if ( char.tradewindow or char2.tradewindow )
    return ret_error( $"walking {gap} tiles away did not cancel the trade" );
  elseif ( gap <= 3 )
    return ret_error( $"the trade was cancelled at a distance of only {gap} tiles" );
  endif
  return items_are_back( item, item2 );
endfunction

/**
 * Helper functions
 */

// Opens a window and puts one item of each side into it.
function offer_from_both_sides( resmgn )
  var res := open_trade();
  if ( !res )
    return res;
  endif

  var item := resmgn.CreateItemInContainer( char.backpack, 0x1F03 );
  var item2 := resmgn.CreateItemInContainer( char2.backpack, 0x1F03 );
  if ( !item || !item2 )
    return !item ? item : item2;
  endif
  item.movable := 1;
  item2.movable := 1;

  res := MoveItemToSecureTradeWin( item, char );
  if ( !res )
    return ret_error( $"Could not offer the item of client 0: {res}" );
  endif
  res := MoveItemToSecureTradeWin( item2, char2 );
  if ( !res )
    return ret_error( $"Could not offer the item of client 1: {res}" );
  endif
  return { item, item2 };
endfunction

function items_are_back( item, item2 )
  if ( item.container.serial != char.backpack.serial )
    return ret_error( $"the item of client 0 is in 0x{item.container.serial:x}, expected its own backpack" );
  elseif ( item2.container.serial != char2.backpack.serial )
    return ret_error( $"the item of client 1 is in 0x{item2.container.serial:x}, expected its own backpack" );
  endif
  return 1;
endfunction

function move_client( id, dir )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "move", arg := dir, id := id } );
  var ev := waitForClient( id, { EVT_MOVED } );
  if ( !ev )
    return ret_error( $"client {id} did not move" );
  endif
  return 1;
endfunction
