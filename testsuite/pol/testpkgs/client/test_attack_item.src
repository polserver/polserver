// tests attacks performed by a client against an attackable item
use os;
use uo;
use attributes;

include "testutil";
include "communication";

const ATTACK_X := 100;
const ATTACK_Y := 100;
const ATTACK_Z := 0;

var char;

var clientcon := getClientConnection();

program chartests()
  var a := FindAccount( "testclient0" );
  char := a.getcharacter( 1 );
  if ( !char )
    return ret_error( "Could not find char at slot 1" );
  endif
endprogram

exported function test_client_attack_item( resources )
  var item := setup_attack( resources );
  if ( !item )
    return item;
  endif

  var ev := send_attack( item.serial, item.serial );
  if ( !ev )
    return ev;
  endif

  var opponent := char.opponent;
  if ( !opponent || opponent != item )
    return ret_error( $"Wrong opponent selected: {opponent}" );
  elseif ( !char.warmode )
    return ret_error( "Client did not enter warmode" );
  endif

  // the client swings at the item
  while ( 1 )
    ev := waitForClient( 0, { EVT_FIGHT_OCCURING } );
    if ( !ev )
      return ret_error( $"Client did not swing at the item: {ev}" );
    endif
    if ( ev.attacker == char.serial && ev.defender == item.serial )
      break;
    endif
  endwhile

  // swings against items always hit
  var res := wait_for_damage( item );
  if ( !res )
    return res;
  endif

  // the new hitpoints of the item are announced to the client
  res := wait_for_client_hits( item.serial );
  if ( !res )
    return res;
  endif

  // stop attacking before the item gets destroyed by the resourcemanager
  return stop_attack();
endfunction

// destroying the item while the client is swinging at it must clear the
// opponent, otherwise the next swing dereferences the destroyed item
exported function test_client_attack_destroy_item( resources )
  var item := setup_attack( resources );
  if ( !item )
    return item;
  endif

  var ev := send_attack( item.serial, item.serial );
  if ( !ev )
    return ev;
  endif

  // the fight is running
  var res := wait_for_swing( item.serial );
  if ( !res )
    return res;
  endif

  Clear_Event_Queue();
  res := DestroyItem( item );
  if ( !res )
    return ret_error( $"Could not destroy item: {res}" );
  endif

  // the destroyed item gets unhighlighted at the client and forgotten
  res := check_attack_stopped();
  if ( !res )
    return res;
  endif

  // a few swing timers pass, all of them with the destroyed item as opponent
  Sleepms( 2000 );
  if ( char.opponent )
    return ret_error( $"Opponent reappeared after the item got destroyed: {char.opponent}" );
  endif

  ev := waitForClient( 0, { EVT_FIGHT_OCCURING }, 2 );
  if ( ev )
    return ret_error( $"Client still swings at 0x{ev.defender:x}" );
  endif

  // and the client is still able to attack another item
  var item2 := resources.CreateItemAtLocation( char.x, char.y, char.z, "AttackableTarget" );
  if ( !item2 )
    return ret_error( $"Could not create item: {item2}" );
  endif

  ev := send_attack( item2.serial, item2.serial );
  if ( !ev )
    return ev;
  endif

  res := wait_for_swing( item2.serial );
  if ( !res )
    return res;
  endif

  // stop attacking before the item gets destroyed by the resourcemanager
  return stop_attack();
endfunction

// an invisible item cannot be attacked
exported function test_client_attack_invis_item( resources )
  var item := setup_attack( resources );
  if ( !item )
    return item;
  endif
  item.invisible := 1;

  var ev := send_attack( item.serial, 0 );
  if ( !ev )
    return ev;
  endif

  if ( char.opponent )
    return ret_error( $"Opponent got selected: {char.opponent}" );
  endif

  return 1;
endfunction

// an item outside of the visual range of the client cannot be attacked
exported function test_client_attack_item_range( resources )
  var item := setup_attack( resources, 40 );
  if ( !item )
    return item;
  endif

  var ev := send_attack( item.serial, 0 );
  if ( !ev )
    return ev;
  endif

  if ( char.opponent )
    return ret_error( $"Opponent got selected: {char.opponent}" );
  endif

  return 1;
endfunction

// a normal item is no valid target at all, the server ignores the request
exported function test_client_attack_normal_item( resources )
  var res := prepare_char();
  if ( !res )
    return res;
  endif

  var item := resources.CreateItemAtLocation( char.x, char.y, char.z, 0xF3F );
  if ( !item )
    return ret_error( $"Could not create item: {item}" );
  endif

  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "attack", arg := item.serial, id := 0 } );
  var ev := waitForClient( 0, { EVT_ATTACK }, 2 );
  if ( ev )
    return ret_error( $"Got a highlight of 0x{ev.serial:x} for a not attackable item" );
  endif

  if ( char.opponent )
    return ret_error( $"Opponent got selected: {char.opponent}" );
  endif

  return 1;
endfunction

// destroy the item due to direct damage
exported function test_client_attack_kill_item( resources )
  var item := setup_attack( resources );
  if ( !item )
    return item;
  endif

  item.hp := 1;

  var ev := send_attack( item.serial, item.serial );
  if ( !ev )
    return ev;
  endif

  // the fight is running
  var res := wait_for_swing( item.serial );
  if ( !res )
    return res;
  endif

  Clear_Event_Queue();
  if ( item )
    return ret_error( "Could not kill item" );
  endif

  // the destroyed item gets unhighlighted at the client and forgotten
  res := check_attack_stopped();
  if ( !res )
    return res;
  endif

  // a few swing timers pass, all of them with the destroyed item as opponent
  Sleepms( 2000 );
  if ( char.opponent )
    return ret_error( $"Opponent reappeared after the item got destroyed: {char.opponent}" );
  endif

  ev := waitForClient( 0, { EVT_FIGHT_OCCURING }, 2 );
  if ( ev )
    return ret_error( $"Client still swings at 0x{ev.defender:x}" );
  endif

  // and the client is still able to attack another item
  var item2 := resources.CreateItemAtLocation( char.x, char.y, char.z, "AttackableTarget" );
  if ( !item2 )
    return ret_error( $"Could not create item: {item2}" );
  endif

  ev := send_attack( item2.serial, item2.serial );
  if ( !ev )
    return ev;
  endif

  res := wait_for_swing( item2.serial );
  if ( !res )
    return res;
  endif

  // stop attacking before the item gets destroyed by the resourcemanager
  return stop_attack();
endfunction

/**
 * Helper functions
 */

// moves the client to the testlocation and creates an attackable item, by
// default on the same tile.
function setup_attack( resources, dist := 0 )
  var res := prepare_char();
  if ( !res )
    return res;
  endif

  var item := resources.CreateItemAtLocation( char.x + dist, char.y, char.z, "AttackableTarget" );
  if ( !item )
    return ret_error( $"Could not create item: {item}" );
  endif

  Clear_Event_Queue();
  return item;
endfunction

// moves the client to the testlocation and makes sure that it is not attacking
// anything anymore
function prepare_char()
  var res := MoveObjectToLocation( char, ATTACK_X, ATTACK_Y, ATTACK_Z, flags := MOVEOBJECT_FORCELOCATION );
  if ( !res )
    return ret_error( $"Could not move player: {res}" );
  endif

  // increase damage
  SetAttributeBaseValue( char, "Strength", 1000 );
  SetAttributeBaseValue( char, "Tactics", 1000 );

  if ( char.opponent || char.warmode )
    return stop_attack();
  endif
  return 1;
endfunction

// leaves warmode, which clears the opponent of the client
function stop_attack()
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "war_mode", arg := 0, id := 0 } );
  var ev := waitForClient( 0, { EVT_WAR_MODE } );
  if ( !ev )
    return ret_error( $"No warmode answer received: {ev}" );
  elseif ( ev.war )
    return ret_error( $"Client is still in warmode: {ev.war}" );
  endif

  // clearing the opponent unhighlights it at the client
  while ( 1 )
    ev := waitForClient( 0, { EVT_ATTACK } );
    if ( !ev )
      return ret_error( $"No highlight received: {ev}" );
    elseif ( !ev.serial )
      break;
    endif
  endwhile

  if ( char.opponent )
    return ret_error( $"Opponent is still set: {char.opponent}" );
  endif
  return 1;
endfunction

// sends an attack request for the given serial and waits for the server to
// highlight the expected object.
function send_attack( serial, expected )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "attack", arg := serial, id := 0 } );
  while ( 1 )
    var ev := waitForClient( 0, { EVT_ATTACK } );
    if ( !ev )
      return ret_error( $"No highlight of 0x{expected:x} received: {ev}" );
    endif
    if ( ev.serial == expected )
      return ev;
    endif
  endwhile
endfunction

// waits until the client swings at the given serial.
// deadline based, since a running fight never stops sending events.
function wait_for_swing( serial, timeout := 10000 )
  var start := ReadMillisecondClock();
  while ( ReadMillisecondClock() - start < timeout )
    var ev := Wait_For_Event( 1 );
    if ( !ev || ev.id != 0 || ev.type != EVT_FIGHT_OCCURING )
      continue;
    endif
    if ( ev.attacker == char.serial && ev.defender == serial )
      return 1;
    endif
  endwhile
  return ret_error( $"Client did not swing at 0x{serial:x} within {timeout}ms" );
endfunction

// the opponent has to be gone and the client told that nothing is highlighted
// anymore. deadline based, since the client keeps receiving the swings of a
// fight that was not stopped.
function check_attack_stopped( timeout := 10000 )
  var start := ReadMillisecondClock();
  var unhighlighted := 0;
  while ( ReadMillisecondClock() - start < timeout )
    var ev := Wait_For_Event( 1 );
    if ( !ev || ev.id != 0 || ev.type != EVT_ATTACK )
      continue;
    endif
    if ( !ev.serial )
      unhighlighted := 1;
      break;
    endif
  endwhile
  if ( !unhighlighted )
    return ret_error( $"Client did not get unhighlighted within {timeout}ms" );
  endif

  if ( char.opponent )
    return ret_error( $"Opponent is still set: {char.opponent}" );
  endif
  return 1;
endfunction

// waits until the client got a hitpoint update (with changed value)
function wait_for_client_hits( serial )
  while ( 1 )
    var ev := waitForClient( 0, { EVT_HP_CHANGED } );
    if ( !ev )
      return ret_error( $"Client received no hitpoints of 0x{serial:x}: {ev}" );
    elseif ( ev.serial != serial || ev.new >= 1000 )
      continue;
    endif
    return 1;
  endwhile
endfunction

// waits until the item lost hitpoints
function wait_for_damage( item, timeout := 10000 )
  var start := ReadMillisecondClock();
  while ( item.hp >= item.maxhp )
    if ( ReadMillisecondClock() - start > timeout )
      return ret_error( $"Item took no damage within {timeout}ms: {item.hp}/{item.maxhp}" );
    endif
    Sleepms( 100 );
  endwhile
  return 1;
endfunction
