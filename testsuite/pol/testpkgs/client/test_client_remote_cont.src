use os;
use uo;
use storage;

include "testutil";
include "communication";

var char;

var clientcon := getClientConnection();

program chartests()
  var a := FindAccount( "testclient0" );
  char := a.getcharacter( 1 );
  if ( !char )
    return ret_error( "Could not find char at slot 1" );
  endif
endprogram

// A container shown with SendOpenSpecialContainer stays reachable only while the character is
// where they were when it was opened. The reach is granted by the core, not by the script that
// opened it, so nothing on the script side can revoke it -- which is why moving has to.
//
// CheckLineOfSight is the probe: a remote container is granted sight outright, ahead of the
// comparison that would otherwise refuse anything in a different realm. So a character standing
// in britannia2 can see a container in britannia if and only if it is still listed as remote.
exported function remote_container_ends_on_move()
  // Placed exactly where the character stands, because SendOpenSpecialContainer writes the
  // character's position onto whatever it is handed. Anywhere else and that write would leave the
  // container filed in a zone its coordinates no longer name, which is a defect of its own and not
  // the one under test here.
  var cont := CreateItemAtLocation( char.x, char.y, char.z, 0x200E75, 1, char.realm );
  if ( !cont )
    return ret_error( "Failed to create container: " + cont );
  endif

  var home := struct{ x := char.x, y := char.y, z := char.z, realm := char.realm };

  var opened := SendOpenSpecialContainer( char, cont );
  if ( !opened )
    DestroyItem( cont );
    return ret_error( "SendOpenSpecialContainer failed: " + opened );
  endif

  if ( !CheckLineOfSight( char, cont ) )
    DestroyItem( cont );
    return ret_error( "The container was not in sight while standing on top of it" );
  endif

  MoveObjectToLocation( char, 100, 100, 0, realm := "britannia2",
                        flags := MOVEOBJECT_FORCELOCATION );

  var still_in_sight := CheckLineOfSight( char, cont );

  MoveObjectToLocation( char, home.x, home.y, home.z, realm := home.realm,
                        flags := MOVEOBJECT_FORCELOCATION );
  DestroyItem( cont );

  if ( still_in_sight )
    return ret_error( "The container is still in sight from another realm after the character moved" );
  endif

  return 1;
endfunction

// Picks an item up with client 0 and expects it to work. There is no success answer for a lift,
// only a rejection, so this waits a moment for one not to arrive.
function lift_allowed( serial )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "lift_item", arg := serial, id := 0 } );
  if ( !waitForClient( 0, { EVT_LIFT_ITEM } ) )
    return ret_error( $"client 0 did not send the lift of 0x{serial:x}" );
  endif
  var ev := waitForClient( 0, { EVT_MOVE_ITEM_REJECTED }, 2 );
  if ( ev )
    return ret_error( $"lifting 0x{serial:x} was refused: reason {ev.reason}" );
  endif
  return 1;
endfunction

function lift_denied( serial )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "lift_item", arg := serial, id := 0 } );
  if ( !waitForClient( 0, { EVT_LIFT_ITEM } ) )
    return ret_error( $"client 0 did not send the lift of 0x{serial:x}" );
  endif
  var ev := waitForClient( 0, { EVT_MOVE_ITEM_REJECTED } );
  if ( !ev )
    return ret_error( $"lifting 0x{serial:x} was allowed" );
  endif
  if ( ev.reason != MOVE_ITEM_FAILURE_CANNOT_PICK_THAT_UP )
    return ret_error( $"lifting 0x{serial:x} was refused with reason {ev.reason}, expected {MOVE_ITEM_FAILURE_CANNOT_PICK_THAT_UP}" );
  endif
  return 1;
endfunction

// Opening a container is refused out loud, so the absence of that line is the answer. Nothing else
// on the double-click path speaks.
function dblclick_not_refused( serial )
  Clear_Event_Queue();
  clientcon.sendevent( struct{ todo := "double_click", arg := serial, id := 0 } );
  if ( !waitForClient( 0, { EVT_DOUBLE_CLICK } ) )
    return ret_error( $"client 0 did not send the double click of 0x{serial:x}" );
  endif
  var ev := waitForClient( 0, { EVT_SPEECH }, 2 );
  if ( ev )
    return ret_error( $"double clicking 0x{serial:x} was refused: {ev.msg}" );
  endif
  return 1;
endfunction

// The bank box, which is what this whole mechanism exists for: a container filed in a storage area
// and shown to one client. Two things have to be true of it at once, and they are the reason the
// reach is granted to the contents rather than to the container.
//
// Its contents are reachable even though nothing that holds them stands anywhere - a storage area
// is in no world, so an item in one has no realm and no position of its own. Everything that
// decides whether a client may touch an item has to cope with that, and the case is easy to break
// while tidying up how a position is derived: a rule that asks an item which world it is in gets no
// answer here, and refusing on that basis locks every bank box on the shard.
//
// The container itself is not reachable, so a player cannot pick their bank box up and walk off
// with it. That is the one thing get_item asks the lookup to tell it apart - a remote container
// lends its contents out and never itself.
exported function bankbox_lends_contents_only()
  var area := FindStorageArea( "clientbank" );
  if ( !area )
    area := CreateStorageArea( "clientbank" );
    if ( !area )
      return ret_error( $"Could not make the storage area: {area}" );
    endif
  endif

  var cont := CreateRootItemInStorageArea( area, "bankbox", 0xE75 );
  if ( !cont )
    return ret_error( $"Could not make the bank box: {cont}" );
  endif

  var res := 1;
  var item := CreateItemInContainer( cont, 0x1F03, 1 );
  if ( !item )
    res := ret_error( $"Could not make the contents: {item}" );
  else
    item.movable := 1;

    var opened := SendOpenSpecialContainer( char, cont );
    if ( !opened )
      res := ret_error( $"SendOpenSpecialContainer failed: {opened}" );
    else
      res := lift_allowed( item.serial );
      if ( res )
        // Back where it came from, which also exercises the drop side of the same reach, and
        // leaves the box empty for the cleanup below.
        Clear_Event_Queue();
        clientcon.sendevent( struct{ todo := "drop_item",
                                     arg := struct{ serial := item.serial, x := 20, y := 20, z := 0,
                                                    dropped_on_serial := cont.serial },
                                     id := 0 } );
        if ( !waitForClient( 0, { EVT_DROP_APPROVED } ) )
          res := ret_error( "putting the item back into the bank box was not approved" );
        elseif ( item.container.serial != cont.serial )
          res := ret_error( $"the item went to 0x{item.container.serial:x}, not back into the box" );
        else
          res := lift_denied( cont.serial );
        endif
      endif
    endif
    DestroyItem( item );
  endif

  // A storage root is marked in use for as long as its area files it, which is what stops anything
  // casually destroying or moving a bank box, so DestroyItem() refuses this one. The area is what
  // has to let go of it - and it clears the flag on the way out.
  DestroyRootItemInStorageArea( area, "bankbox" );
  return res;
endfunction

// Every question a client's request has to pass is asked about where things are, and a bank box is
// nowhere at all. It used to be handed the character's own coordinates on the way to the screen,
// which made the answers come out right for the wrong reason and left a container claiming to stand
// somewhere it had never been. Having been shown it is what puts it in reach now, so the coordinates
// are not needed and are not written.
//
// Three requests read that position and each is checked here: opening the box, taking something out
// of it, and putting something back onto it. The last is dropped onto the container rather than into
// a cell of it, which is a different route through the core with its own copy of the check.
exported function bankbox_needs_no_position()
  var area := FindStorageArea( "clientbank" );
  if ( !area )
    area := CreateStorageArea( "clientbank" );
    if ( !area )
      return ret_error( $"Could not make the storage area: {area}" );
    endif
  endif

  var cont := CreateRootItemInStorageArea( area, "reachbox", 0xE75 );
  if ( !cont )
    return ret_error( $"Could not make the bank box: {cont}" );
  endif

  var res := 1;
  var item := CreateItemInContainer( cont, 0x1F03, 1 );
  if ( !item )
    res := ret_error( $"Could not make the contents: {item}" );
  else
    item.movable := 1;

    var opened := SendOpenSpecialContainer( char, cont );
    if ( !opened )
      res := ret_error( $"SendOpenSpecialContainer failed: {opened}" );
    elseif ( cont.x != 0 || cont.y != 0 )
      res := ret_error( $"the bank box was placed at {cont.x},{cont.y} while the character stands at {char.x},{char.y}" );
    else
      res := dblclick_not_refused( cont.serial );
      if ( res )
        res := lift_allowed( item.serial );
      endif
      if ( res )
        Clear_Event_Queue();
        clientcon.sendevent( struct{ todo := "drop_item",
                                     arg := struct{ serial := item.serial, x := 0xFFFF, y := 0xFFFF,
                                                    z := 0, dropped_on_serial := cont.serial },
                                     id := 0 } );
        if ( !waitForClient( 0, { EVT_DROP_APPROVED } ) )
          res := ret_error( "dropping the item onto the bank box was not approved" );
        elseif ( item.container.serial != cont.serial )
          res := ret_error( $"the item went to 0x{item.container.serial:x}, not onto the box" );
        endif
      endif
    endif
    DestroyItem( item );
  endif

  DestroyRootItemInStorageArea( area, "reachbox" );
  return res;
endfunction

// The other half of standing nowhere: being told about it. When something a client can see changes
// its name, the core announces the new revision so the client drops its cached tooltip. It finds
// who to tell by walking the region the object stands in - which answers nobody for a bank box, so
// the announcement has to fall back to asking who was shown the container.
exported function bankbox_change_is_announced()
  var area := FindStorageArea( "clientbank" );
  if ( !area )
    area := CreateStorageArea( "clientbank" );
    if ( !area )
      return ret_error( $"Could not make the storage area: {area}" );
    endif
  endif

  var cont := CreateRootItemInStorageArea( area, "revbox", 0xE75 );
  if ( !cont )
    return ret_error( $"Could not make the bank box: {cont}" );
  endif

  var res := 1;
  var item := CreateItemInContainer( cont, 0x1F03, 1 );
  if ( !item )
    res := ret_error( $"Could not make the contents: {item}" );
  else
    var opened := SendOpenSpecialContainer( char, cont );
    if ( !opened )
      res := ret_error( $"SendOpenSpecialContainer failed: {opened}" );
    else
      // Showing the container announces the container's own revision, and that packet is in flight
      // rather than queued - clearing the queue does not catch it. Drain it here, or the wait below
      // passes on it and never looks at the item at all.
      Clear_Event_Queue();
      var stale := waitForClient( 0, { EVT_OBJ_REVISION }, 1 );
      while ( stale )
        stale := waitForClient( 0, { EVT_OBJ_REVISION }, 1 );
      endwhile

      item.name := "a renamed thing";

      var ev := waitForClient( 0, { EVT_OBJ_REVISION } );
      if ( !ev )
        res := ret_error( "the client was not told the item in the bank box had changed" );
      elseif ( ev.serial != item.serial )
        res := ret_error( $"told about 0x{ev.serial:x}, expected the item 0x{item.serial:x}" );
      endif
    endif
    DestroyItem( item );
  endif

  DestroyRootItemInStorageArea( area, "revbox" );
  return res;
endfunction

// An item going away has to be announced as well, and that direction has nothing to fall back on.
// Being put in or changed reaches whoever was shown the container; being removed is told to whoever
// the region the item stands in turns up, and a bank box stands in none -- so that walk reaches
// nobody and the client goes on drawing an item that no longer exists.
//
// DestroyItem is the probe because it is a removal and nothing else. Every other way out of the box
// sends the item's new home straight after, which lets a client re-parent it and repairs the view by
// accident, hiding the missing removal rather than showing it.
exported function bankbox_removal_is_announced()
  var area := FindStorageArea( "clientbank" );
  if ( !area )
    area := CreateStorageArea( "clientbank" );
    if ( !area )
      return ret_error( $"Could not make the storage area: {area}" );
    endif
  endif

  var cont := CreateRootItemInStorageArea( area, "delbox", 0xE75 );
  if ( !cont )
    return ret_error( $"Could not make the bank box: {cont}" );
  endif

  var res := 1;
  var item;
  var destroyed := 0;
  do
    item := CreateItemInContainer( cont, 0x1F03, 1 );
    if ( !item )
      res := ret_error( $"Could not make the contents: {item}" );
      break;
    endif

    // Read while the item still has one: destroying it clears the serial.
    var serial := item.serial;

    var opened := SendOpenSpecialContainer( char, cont );
    if ( !opened )
      res := ret_error( $"SendOpenSpecialContainer failed: {opened}" );
      break;
    endif

    // The client has to be holding the item before a missing removal can be told from anything
    // else. Without this the wait below is equally satisfied by a client that was never sent the
    // contents at all -- the same silence, for the opposite reason, and a test that passes on it
    // whichever way the core behaves.
    var known := client_finds_obj( clientcon, 0, serial, cont.serial );
    if ( !known )
      res := ret_error( $"client 0 never saw the item in the bank box: {known}" );
      break;
    endif

    Clear_Event_Queue();
    DestroyItem( item );
    destroyed := 1;

    var ev := waitForClient( 0, { EVT_REMOVED_OBJ } );
    if ( !ev )
      res := ret_error( "the client was not told the item in the bank box was destroyed" );
    elseif ( CInt( ev.serial ) != CInt( serial ) )
      res := ret_error( $"told 0x{CInt( ev.serial ):x} went away, expected the item 0x{serial:x}" );
    endif
  dowhile ( false );

  if ( item && !destroyed )
    DestroyItem( item );
  endif

  DestroyRootItemInStorageArea( area, "delbox" );
  return res;
endfunction

// The same announcement, for a container that does stand somewhere. SendOpenSpecialContainer takes
// any container at any distance -- it never asks where either party is -- so a chest on the ground
// can be shown to somebody nowhere near it, who may then take things out of it.
//
// That makes the two audiences overlap rather than alternate: whoever stands next to the chest, and
// whoever was shown it. Deciding between them on whether the container has a position answers the
// first and silently drops the second, which is what a walk over the chest's own region does.
exported function worldbox_removal_reaches_viewer()
  var cont := CreateItemAtLocation( char.x + 4, char.y, char.z, 0x200E75, 1, char.realm );
  if ( !cont )
    return ret_error( $"Failed to create the chest: {cont}" );
  endif

  var res := 1;
  var item;
  var destroyed := 0;
  var home := struct{ x := char.x, y := char.y, z := char.z, realm := char.realm };

  do
    item := CreateItemInContainer( cont, 0x1F03, 1 );
    if ( !item )
      res := ret_error( $"Could not make the contents: {item}" );
      break;
    endif
    var serial := item.serial;

    // Shown while standing on top of it, so the client is sent the contents...
    var opened := SendOpenSpecialContainer( char, cont );
    if ( !opened )
      res := ret_error( $"SendOpenSpecialContainer failed: {opened}" );
      break;
    endif

    var known := client_finds_obj( clientcon, 0, serial, cont.serial );
    if ( !known )
      res := ret_error( $"client 0 never saw the item in the chest: {known}" );
      break;
    endif

    // ... and the reach is then taken away from geometry, without taking it away from membership.
    // Moving would flush the list, so the chest is what travels: it goes far enough that nobody
    // standing near it is near the character any more.
    MoveObjectToLocation( cont, char.x + 40, char.y + 40, char.z, char.realm,
                          MOVEOBJECT_FORCELOCATION );
    if ( char.x - cont.x <= 18 && cont.x - char.x <= 18 )
      res := ret_error( $"the chest did not end up out of visual range: {cont.x},{cont.y} vs {char.x},{char.y}" );
      break;
    endif

    // Taking the chest out of sight is itself announced, correctly and for the chest's own serial.
    // That packet is in flight rather than queued, so clearing the queue does not catch it: without
    // draining it the wait below is answered by the chest going away, one serial below the item,
    // and never looks at the item at all.
    Clear_Event_Queue();
    var stale := waitForClient( 0, { EVT_REMOVED_OBJ }, 1 );
    while ( stale )
      stale := waitForClient( 0, { EVT_REMOVED_OBJ }, 1 );
    endwhile

    DestroyItem( item );
    destroyed := 1;

    var ev := waitForClient( 0, { EVT_REMOVED_OBJ } );
    if ( !ev )
      res := ret_error( "the client was not told the item in the chest it was shown was destroyed" );
    elseif ( CInt( ev.serial ) != CInt( serial ) )
      res := ret_error( $"told 0x{CInt( ev.serial ):x} went away, expected the item 0x{serial:x}" );
    endif
  dowhile ( false );

  if ( item && !destroyed )
    DestroyItem( item );
  endif
  DestroyItem( cont );
  MoveObjectToLocation( char, home.x, home.y, home.z, home.realm, MOVEOBJECT_FORCELOCATION );
  return res;
endfunction
