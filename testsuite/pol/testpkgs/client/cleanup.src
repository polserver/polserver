use uo;
use os;
use guilds;
include "testutil";
include "communication";
include "guildutil";

// Nothing in the core ever removes a guild, and one that still holds a member,
// an ally or an enemy refuses to be destroyed - so a case that failed halfway
// would leave its guilds in the world save for good. Take them apart before the
// two characters go, while there is still something to remove them from.
foreach guild in ( ListGuilds() )
  if ( guild.getprop( TEST_GUILD_PROP ) )
    var dropped := drop_guild( guild );
    if ( !dropped )
      syslog( $"testclient: could not destroy guild {guild.guildid}: {dropped}", 0 );
    endif
  endif
endforeach

// The commit script is shard-wide and holds every commit while this is set, so
// a case that failed while it was armed would leave the rest of the run unable
// to commit a house at all.
EraseGlobalProperty( "#HouseCommitHold" );

// Both hooks are shard-wide too: armed, one stops every cast in the run and the
// other stops every spellbook from opening. The spell script's hold is armed
// from here rather than from its own package, so it is dropped from here as well.
EraseGlobalProperty( "#CastHookCancel" );
EraseGlobalProperty( "#OpenBookCancel" );
EraseGlobalProperty( "#TestSpellHold" );

foreach multi in ( ListMultisInBox( 0, 0, -200, 10000, 10000, 200 ) )
  DestroyMulti( multi );
endforeach

var clientcon := getClientConnection();
if ( clientcon )
  clientcon.sendevent( struct{ todo := "exit" } );
  WaitForClient( 0, { EVT_EXIT }, 2 );
endif
var a := FindAccount( "testclient0" );
if ( a )
  a.deletecharacter( 1 );
  a.delete();
endif
a := FindAccount( "testclient1" );
if ( a )
  a.deletecharacter( 1 );
  a.delete();
endif

var res := GetGlobalProperty( "#SnoopingNpc" );
if ( res )
  var mob := SystemFindObjectBySerial( res );
  MoveObjectToLocation( mob, 0, 0, 0, flags := MOVEOBJECT_FORCELOCATION );
  mob.Kill();
endif
