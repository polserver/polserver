include "testutil";

use os;

program setup()
  return 1;
endprogram

var glob := 1;
var myOtherGlob := "myOtherGlob";
var cb_glob := "cb";

exported function test_call()
  var res := run_script_to_completion( ":testfuncref:external", @user_func );

  if ( res != "called foo(), res=return from user_func" )
    return ret_error( $"incorrect return value from run_script_to_completion. got: {res}" );
  elseif ( glob != "glob set inside user_func" )
    return ret_error( $"incorrect global value for 'glob': {glob}" );
  endif

  return 1;
endfunction

exported function test_call_noglobals()
  var res := run_script_to_completion( ":testfuncref:external", @user_func_no_globals );

  if ( res != "called foo(), res=return from user_func_no_globals" )
    return ret_error( $"incorrect return value from run_script_to_completion. got: {res}" );
  endif

  return 1;
endfunction

exported function test_call_embedded_globals()
  var res := run_script_to_completion( ":testfuncref:external", @embedded_globals );

  if ( res != "called foo(), res=return from embedded_globals" )
    return ret_error( $"incorrect return value from run_script_to_completion. got: {res}" );
  elseif ( glob != "glob set inside embedded_globals" )
    return ret_error( $"incorrect global value for 'glob': {glob}" );
  endif

  return 1;
endfunction

// Spawns a script (the 'destroyed' script) that sends its own user-func to
// another script (the 'call' script). The 'destroyed' script then ends. This
// test script sends event to the 'call' script which calls the 'destroy'd
// script's user function, as well a function in test script (the 'mapper' function.)
exported function test_call_destroyed_executor()
  var res := start_script( ":testfuncref:destroyed", GetPid() );

  if ( !res )
    return res;
  endif

  var destroyed_pid := res.pid;

  var ev := wait_for_event( 1 );

  if ( !ev )
    return ev;
  elseif ( ev.type != "spawned" )
    return ret_error( $"Unexpected event {ev}" );
  elseif ( !ev.result )
    return ev.result;
  endif

  var spawned := ev.result;

  outer: do
    for i := 1 to 5
      if ( !GetProcess( destroyed_pid ) )
        break outer;
      endif
      Sleepms( 1 );
    endfor
    return ret_error( $"Spawned process not destroyed in time" );
  dowhile ( 0 );

  spawned.SendEvent( struct{ type := "call_with_locals",
                             pid := GetPid(), args := { 1, 2, 3 },
                             mapper := @( what ) {
    return what * 100;
  } } );

  ev := wait_for_event( 1 );

  if ( !ev )
    return ret_error( $"no return from 'call' event: {ev}" );
  elseif ( ev.type != "return" )
    return ret_error( $"Unexpected event {ev}" );
  endif

  var result := ev.result;

  // the two locals in `destroyed` + the arguments array passed above,
  // passed through the mapper function.
  var expected := "true hello local DestroyedUserFunc({ 100, 200, 300 })";

  return ret_error_not_equal( result, expected,
                              $"Unexpected return from call, expected '{expected}', actual '{result}'" );
endfunction

// calls the function in the destroyed script which access globals
// this has to stop the calling script since its an illegal access.
exported function test_call_destroyed_globals()
  var res := start_script( ":testfuncref:destroyed", GetPid() );

  if ( !res )
    return res;
  endif

  var destroyed_pid := res.pid;

  var ev := wait_for_event( 1 );

  if ( !ev )
    return ev;
  elseif ( ev.type != "spawned" )
    return ret_error( $"Unexpected event {ev}" );
  elseif ( !ev.result )
    return ev.result;
  endif

  var spawned := ev.result;

  outer: do
    for i := 1 to 5
      if ( !GetProcess( destroyed_pid ) )
        break outer;
      endif
      Sleepms( 1 );
    endfor
    return ret_error( $"Spawned process not destroyed in time" );
  dowhile ( 0 );

  spawned.SendEvent( struct{ type := "call_with_globals",
                             pid := GetPid(), args := { 1, 2, 3 },
                             mapper := @( what ) {
    return what * 100;
  } } );

  ev := wait_for_event( 1 );

  if ( !ev )
    if ( spawned.state.errortext != "Script has been destroyed" )
      return ret_error( $"Spawned script wasnt destroyed {spawned.state}" );
    endif
    return 1;
  endif
  return ret_error( $"Unexpected event {ev}" );
endfunction

exported function test_call_sameprog()
  var res := run_script( ":testfuncref:send_same_prog", { GetPid(), "main" } );
  return ret_error_not_equal( res, "secondary", $"wrong global capture: {res}" );
endfunction

function user_func()
  glob := "glob set inside user_func";
  return "return from user_func";
endfunction

function user_func_no_globals()
  return "return from user_func_no_globals";
endfunction

function embedded_globals()
  return @{
    return @{
      glob := "glob set inside embedded_globals";
      return "return from embedded_globals";
    }();
  }();
endfunction


// A script that calls one of its own function references while it is executing inside another
// script's function has to switch the program context back: the jump target is an offset in the
// function reference's program, not in the one currently loaded.
exported function test_call_back_into_caller()
  var h := start_callback_script();

  if ( !h )
    return h;
  endif

  // the reference has to go through a variable: `h.callee( ... )` is a method call on the struct
  var callee := h.callee;
  var res := callee( @my_own_func );

  h.proc.SendEvent( 1 );

  return ret_error_not_equal( res, "p1|mine:cb", $"wrong program context: {res}" );
endfunction

// A function reference built while this executor was inside another program carries that
// program but this executor's pid, so a pid comparison alone does not detect it.
exported function test_ref_made_in_ext_prog()
  var h := start_callback_script();

  if ( !h )
    return h;
  endif

  var maker := h.maker;
  var remote := maker();
  var res := remote();

  h.proc.SendEvent( 1 );

  return ret_error_not_equal( res, "p1", $"wrong program context: {res}" );
endfunction

// Two instances of one class, created by two different scripts, must not share globals when the
// same method is called on both from this executor.
exported function test_classinst_globals()
  var one := start_owner_script( "one" );

  if ( !one )
    return one;
  endif

  var two := start_owner_script( "two" );

  if ( !two )
    return two;
  endif

  var res := { one.inst.who(), two.inst.who() };

  one.proc.SendEvent( 1 );
  two.proc.SendEvent( 1 );

  return ret_error_not_equal( res, { "one", "two" },
                              $"class method ran against the wrong script's globals: {res}" );
endfunction

// Constructing through a constructor function reference received from another program must build
// the instance from that program, not from the one this executor is running.
exported function test_classinst_ctor_ref()
  var one := start_owner_script( "one" );

  if ( !one )
    return one;
  endif

  var ctor := one.inst.function;
  var fresh := ctor.new();
  var res := fresh.who();

  one.proc.SendEvent( 1 );

  return ret_error_not_equal( res, "one", $"instance built from the wrong program: {res}" );
endfunction

function start_callback_script()
  var proc := start_script( ":testfuncref:callback", GetPid() );

  if ( !proc )
    return proc;
  endif

  var ev := wait_for_event( 1 );

  if ( !ev )
    return ret_error( $"no event from callback script: {ev}" );
  elseif ( ev.type != "ready" )
    return ret_error( $"Unexpected event {ev}" );
  endif

  return struct{ proc := proc, callee := ev.callee, maker := ev.maker };
endfunction

function start_owner_script( owner )
  var proc := start_script( ":testfuncref:classowner", { GetPid(), owner } );

  if ( !proc )
    return proc;
  endif

  var ev := wait_for_event( 1 );

  if ( !ev )
    return ret_error( $"no event from classowner script: {ev}" );
  elseif ( ev.type != "instance" )
    return ret_error( $"Unexpected event {ev}" );
  endif

  return struct{ proc := proc, inst := ev.inst, owner := ev.owner };
endfunction

function my_own_func()
  return $"mine:{cb_glob}";
endfunction
