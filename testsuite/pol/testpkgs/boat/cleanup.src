use uo;

foreach multi in ( ListMultisInBox( 0, 0, -200, 10000, 10000, 200 ) )
  DestroyMulti( multi );
endforeach

// The walkon cases park their probe NPC on 100,100 and kill it there, so the package
// leaves a corpse behind per case. Nothing here minds, but the house tests raise a
// multi on that square and a corpse blocks it - and what cleared them until now was a
// sweep in a later package's corpse test, which only ran because that package happened
// to run at all. The package that makes them takes them away.
foreach corpse in ( ListItemsNearLocationOfType( 100, 100, 0, 15, 0x2006 ) )
  DestroyItem( corpse );
endforeach
