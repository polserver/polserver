// Helper for test_auxstall.src (not a test file itself). Transmits more than a deaf
// peer's receive window can hold, then reports how many milliseconds the core took to
// give up on the connection (-1 if it never did). Started with keep_connection := 1 so
// our own receive timeout does not close the socket first.
use os;
use polsys;

program auxservice( conn, params )
  // 16 MiB in 4 MiB writes. The peer's receive window is tiny (deafclient.py sets
  // SO_RCVBUF on its listening socket), but that alone does not stall a sender: Linux
  // gives a loopback socket a ~2.5 MB send buffer, which swallows anything smaller
  // whole and leaves nothing for the stall budget to catch. The total has to exceed
  // the sender's own buffer -- net.core.wmem_max is 4 MB by default -- not just the
  // peer's, so 16 MiB keeps a wide margin on every platform. Few, large transmits
  // rather than many small ones: each queued transmit occupies an aux pool worker
  // that then blocks on the connection's transmit mutex for the whole stall.
  var chunk := "x";
  while ( Len( chunk ) < 4194304 )
    chunk := chunk + chunk;
  endwhile

  var start := ReadMillisecondClock();
  for i := 1 to 4
    conn.transmit( chunk );
  endfor

  // the only event this connection can produce is the "connection closed" error the
  // reader signals once the core drops the stalled peer
  var elapsed := -1;
  var loops := 100;  // 50s safety net, above the shard's StalledPeerTimeout plus poll
  while ( loops > 0 )
    loops -= 1;
    if ( Events_Waiting() )
      elapsed := ReadMillisecondClock() - start;
      break;
    endif
    Sleepms( 500 );
  endwhile

  GetProcess( params.test_script_pid ).SendEvent( struct{ elapsed := elapsed } );
endprogram
