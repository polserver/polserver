// Regression test: a transmit to an aux peer that stopped reading must not hang forever.
//
// Aux transmits run on a thread pool and hold the connection's transmit mutex while they
// send, so before aux sockets were made non-blocking a peer that stopped reading pinned
// that thread -- and every later transmit queued behind it -- until the OS TCP timeout
// (minutes). Non-blocking, Socket::send() gives up after 60 seconds without progress and
// closes the connection, which the script sees as "connection closed".
//
// Unlike the webserver case this costs a full minute of wall clock: blocking and
// non-blocking sockets behave identically until that budget expires, so there is nothing
// cheaper to observe.
use os;
include "testutil";

const DEAFCLIENT_PORT := 5011;
const AUX_PORT        := 5012;
// longer than the core's stall budget, so the core is what ends the connection
const HOLD_SECONDS    := 90;

// The core gives up after 60s without progress and the reader notices within its 5s poll,
// so a pass lands near 62s. The upper bound has to stay well below HOLD_SECONDS: without
// the fix the connection survives until the peer itself closes, and a bound at the hold
// time would make that a pass by a few milliseconds.
const MIN_GIVEUP_MS   := 30000;
const MAX_GIVEUP_MS   := 75000;

exported function test_aux_stalled_peer( )
  var ctl := OpenConnection( "127.0.0.1", DEAFCLIENT_PORT, "deafctl",
                             params := struct{
                               test_script_pid := GetPid(),
                               command := $"DEAFLISTEN {AUX_PORT} {HOLD_SECONDS}" },
                             assume_string := 1, keep_connection := 1,
                             ignore_line_breaks := 0 );
  if ( !ctl )
    return ret_error( $"could not reach the deaf client helper: {ctl}" );
  endif

  var ready := wait_for_event( 30 );
  if ( !ready or !ready.listening )
    return ret_error( "deaf client helper never opened its listening port" );
  endif

  var conn := OpenConnection( "127.0.0.1", AUX_PORT, "auxstall",
                              params := struct{ test_script_pid := GetPid() },
                              assume_string := 1, keep_connection := 1,
                              ignore_line_breaks := 1 );
  if ( !conn )
    return ret_error( $"could not connect to the deaf listener: {conn}" );
  endif

  var report := wait_for_event( 150 );
  if ( !report )
    return ret_error( "aux client never reported back" );
  endif

  var elapsed := CInt( report.elapsed );
  if ( elapsed < 0 )
    return ret_error( "the core never gave up on an aux peer that stopped reading: the transmit stays stuck until the OS TCP timeout" );
  endif
  if ( elapsed > MAX_GIVEUP_MS )
    return ret_error( $"the core did not drop the stalled aux peer: the connection only ended after {elapsed}ms, when the peer closed it, instead of at the core's own 60000ms budget" );
  endif
  if ( elapsed < MIN_GIVEUP_MS )
    return ret_error( $"the stalled aux connection ended after only {elapsed}ms, expected about 60000ms" );
  endif

  return 1;
endfunction
