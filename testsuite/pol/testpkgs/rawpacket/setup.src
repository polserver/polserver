// The raw-packet tests need testsuite/rawpeer/rawpeer.py running alongside the shard,
// which cmake/core_tests_start.cmake only starts when python3 was found.
use os;
include "testutil";

program setup()
  var have_helper := GetEnvironmentVariable( "POLCORE_TESTRAWPEER" ) == "TRUE";
  if ( !have_helper )
    syslog( "NO RAW PACKET TESTS", 0 );
    return IGNORE_TEST;
  endif
  return 1;
endprogram
